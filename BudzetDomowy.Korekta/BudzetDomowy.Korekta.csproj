<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BudzetDomowy.Core\BudzetDomowy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>BudzetDomowy.Korekta</AssemblyName>
    <RootNamespace>BudzetDomowy.Korekta</RootNamespace>
    <ApplicationIcon>..\BudzetDomowy.App\Assets\BudzetDomowy.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The WPF SDK drops these two from the implicit usings -->
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\BudzetDomowy.App\Assets\BudzetDomowy.ico" Link="Assets\BudzetDomowy.ico" />
  </ItemGroup>

</Project>
