<Window x:Class="BudzetDomowy.App.Views.PaymentEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        xmlns:controls="clr-namespace:BudzetDomowy.App.Controls"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/BudzetDomowy.App;component/Assets/BudzetDomowy.ico"
        Title="{Binding Title}" Width="760" Height="600" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- the payee: chosen from the list or added -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="PayeeBox" ItemsSource="{Binding Payees}" SelectedItem="{Binding SelectedPayee, Mode=TwoWay}" DisplayMemberPath="Name"
                      HorizontalAlignment="Stretch" ui:ControlHelper.Header="{infra:Str PayPayee}" ui:ControlHelper.PlaceholderText="{infra:Str PayPayeeHint}" />
            <Button Grid.Column="1" Content="{infra:Str PayNewPayee}" Command="{Binding NewPayeeCommand}" VerticalAlignment="Bottom" Margin="10,0,0,0" IsTabStop="False" />
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding PayeeAccount}" FontFamily="Consolas" Opacity="0.8" Margin="0,6,0,0" />

        <!-- the bills: date, title, amount; Enter in the amount opens the next row -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,4" Opacity="0.7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="{infra:Str PayColDue}" />
                    <TextBlock Grid.Column="2" Text="{infra:Str PayColTitle}" Margin="10,0,0,0" />
                    <TextBlock Grid.Column="3" Text="{infra:Str PayColAmount}" Margin="10,0,0,0" />
                </Grid>
                <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProposal}" Value="True">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number, StringFormat={}{0}.}" VerticalAlignment="Center" Opacity="0.6" />
                                <DatePicker x:Name="RowDate" Grid.Column="1" SelectedDate="{Binding DueDate, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                <TextBox x:Name="RowTitle" Grid.Column="2" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0"
                                         ui:ControlHelper.PlaceholderText="{infra:Str PayTitleHint}" />
                                <controls:ExpressionBox x:Name="RowAmount" Grid.Column="3" Expression="{Binding AmountExpression, Mode=TwoWay}" DisplayText="{Binding Display}"
                                                        TextAlignment="Right" Margin="10,0,0,0" ui:ControlHelper.PlaceholderText="0,00" ToolTip="{infra:Str EntryAmountTip}" />
                                <Button Grid.Column="4" Content="✕" Margin="8,0,0,0" Padding="0" Width="32" Height="32" IsTabStop="False" ToolTip="{infra:Str EntryRemoveLine}"
                                        Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="+" Command="{Binding AddRowCommand}" Width="44" Height="32" Padding="0" FontSize="18" Margin="30,0,0,0" IsTabStop="False"
                        ToolTip="{infra:Str PayAddRow}" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="{StaticResource ExpenseBrush}" TextWrapping="Wrap" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{infra:Str Cancel}" Click="Cancel_Click" MinWidth="110" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Content="{infra:Str EntryConfirm}" Click="Confirm_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="130" />
        </StackPanel>
    </Grid>
</Window>
