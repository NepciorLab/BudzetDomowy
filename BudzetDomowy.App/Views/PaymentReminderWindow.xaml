<Window infra:Help.Topic="payments.reminders" x:Class="BudzetDomowy.App.Views.PaymentReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/BudzetDomowy.App;component/Assets/BudzetDomowy.ico"
        Title="{infra:Str PayReminderTitle}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="{infra:Str PayReminderQuestion}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Relative}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLate}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ExpenseBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding Due}" Opacity="0.75" />

        <TextBlock Text="{Binding Amount}" FontSize="26" FontWeight="Bold" Margin="0,12,0,0" />
        <TextBlock Text="{Binding PayeeName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Opacity="0.85" />
        <TextBlock Text="{Binding Account}" FontFamily="Consolas" Opacity="0.75" Margin="0,4,0,0" />

        <TextBlock Text="{infra:Str PayReminderHint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,16,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{infra:Str PayReminderLater}" IsCancel="True" Click="Later_Click" MinWidth="130" Margin="0,0,8,0" />
            <Button Content="{infra:Str PayReminderPayNow}" Click="PayNow_Click" MinWidth="130" Margin="0,0,8,0" Style="{StaticResource AccentButtonStyle}" IsDefault="True" />
            <Button Content="{infra:Str PayReminderPaid}" Click="Paid_Click" MinWidth="130" />
        </StackPanel>
    </StackPanel>
</Window>
