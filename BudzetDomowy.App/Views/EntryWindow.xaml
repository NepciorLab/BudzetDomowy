<Window x:Class="BudzetDomowy.App.Views.EntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        xmlns:controls="clr-namespace:BudzetDomowy.App.Controls"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/BudzetDomowy.App;component/Assets/BudzetDomowy.ico"
        Title="{Binding Title}" Width="780" Height="680" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- the whole receipt: date, place, total, currency, event -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <DatePicker x:Name="DateBox" SelectedDate="{Binding Date, Mode=TwoWay}" Margin="0,0,10,0" HorizontalAlignment="Stretch"
                        ui:ControlHelper.Header="{infra:Str QuickDate}" />
            <controls:PlaceBox x:Name="PlaceBox" Grid.Column="1" Text="{Binding Place, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"
                               Suggestions="{Binding PlaceSuggestions}" ui:ControlHelper.Header="{infra:Str QuickPlace}" />
            <controls:ExpressionBox x:Name="TotalBox" Grid.Column="2" Expression="{Binding TotalText, Mode=TwoWay}" DisplayText="{Binding TotalDisplay}"
                                    Margin="0,0,10,0" TextAlignment="Right" ToolTip="{infra:Str EntryAmountTip}"
                                    ui:ControlHelper.Header="{infra:Str EntryTotal}" ui:ControlHelper.PlaceholderText="0,00" />
            <ComboBox x:Name="CurrencyBox" Grid.Column="3" ItemsSource="{Binding Currencies}" DisplayMemberPath="Code" SelectedValuePath="Code"
                      SelectedValue="{Binding CurrencyCode, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      ui:ControlHelper.Header="{infra:Str QuickCurrency}" ToolTip="{infra:Str QuickCurrencyTip}" />
        </Grid>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="EventBox" ItemsSource="{Binding Events}" DisplayMemberPath="Name" SelectedValuePath="Key"
                      SelectedValue="{Binding EventKey, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,10,0"
                      ui:ControlHelper.Header="{infra:Str QuickEvent}" />
            <TextBox x:Name="NoteBox" Grid.Column="1" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                     ui:ControlHelper.Header="{infra:Str QuickNote}" ui:ControlHelper.PlaceholderText="{infra:Str QuickNoteHint}" />
        </Grid>

        <!-- exchange rate: only for a foreign currency -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsForeign, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{infra:Str RateLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="RateBox" Width="100" IsTabStop="False" Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{infra:Str RateTip}" />
            <Button Content="↻" Command="{Binding ResetRateCommand}" Margin="6,0,0,0" IsTabStop="False" ToolTip="{infra:Str RateReset}" />
            <TextBlock Text="{Binding RateInfo}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8" />
            <TextBlock Text="{Binding ConvertedText}" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold"
                       Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
        </StackPanel>

        <!-- the items of the receipt -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{infra:Str EntryLines}" Opacity="0.7" Margin="0,0,0,4" />
                <ItemsControl x:Name="LinesList" ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number, StringFormat={}{0}.}" VerticalAlignment="Center" Opacity="0.6" />
                                <controls:FilterComboBox x:Name="LineCategory" Grid.Column="1" Margin="0,0,10,0" HorizontalAlignment="Stretch"
                                                         Choices="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding CategoryId, Mode=TwoWay}"
                                                         ui:ControlHelper.PlaceholderText="{infra:Str QuickCategoryHint}" />
                                <controls:ExpressionBox x:Name="LineAmount" Grid.Column="2" Expression="{Binding AmountExpression, Mode=TwoWay}"
                                                        DisplayText="{Binding Display}" TextAlignment="Right" ToolTip="{infra:Str EntryAmountTip}"
                                                        ui:ControlHelper.PlaceholderText="0,00" />
                                <Button Grid.Column="3" Content="✕" Margin="8,0,0,0" Padding="0" Width="32" Height="32" IsTabStop="False"
                                        ToolTip="{infra:Str EntryRemoveLine}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="AddLineButton" Content="+" Command="{Binding AddEmptyLineCommand}" Width="44" Height="32" Padding="0" FontSize="18"
                        ToolTip="{infra:Str EntryAddLine}" Margin="30,0,0,0" IsTabStop="False" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="5" Text="{Binding Summary}" Opacity="0.85" Margin="0,8,0,0" />
        <TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Foreground="{StaticResource ExpenseBrush}" TextWrapping="Wrap" HorizontalAlignment="Right" MaxWidth="440"
                   Margin="0,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{infra:Str Cancel}" Click="Cancel_Click" MinWidth="110" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Content="{infra:Str EntryConfirm}" Click="Confirm_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="130"
                    ToolTip="{infra:Str QuickAddTip}" />
        </StackPanel>
    </Grid>
</Window>
