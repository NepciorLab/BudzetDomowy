<UserControl infra:Help.Topic="budgets" x:Class="BudzetDomowy.App.Views.BudgetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
             xmlns:controls="clr-namespace:BudzetDomowy.App.Controls">
    <UserControl.Resources>
        <infra:HexToBrushConverter x:Key="HexToBrush" />
        <Style x:Key="BarStyle" TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource IncomeBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Over">
                    <Setter Property="Foreground" Value="{StaticResource ExpenseBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="◀" Command="{Binding PreviousMonthCommand}" Width="40" />
            <TextBlock Text="{Binding MonthTitle}" FontSize="24" FontWeight="SemiBold" Width="260" TextAlignment="Center" VerticalAlignment="Center" />
            <Button Content="▶" Command="{Binding NextMonthCommand}" Width="40" />
            <Button Content="{infra:Str DashToday}" Command="{Binding ThisMonthCommand}" Margin="12,0,0,0" />
            <Button infra:Help.Topic="budgets.copy" Content="{infra:Str BudgetsCopy}" Command="{Binding CopyPreviousCommand}" Margin="12,0,0,0" ToolTip="{infra:Str BudgetsCopyTip}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{infra:Str BudgetsHint}" Opacity="0.7" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,8">
            <TextBlock Text="{Binding TotalText}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Message}" Margin="16,0,0,0" Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
        </StackPanel>

        <Border Grid.Row="3" CornerRadius="10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,6" Opacity="0.7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{infra:Str ColCategory}" />
                    <TextBlock Grid.Column="1" Text="{infra:Str BudgetsLimit}" Margin="8,0" />
                    <TextBlock Grid.Column="2" Text="{infra:Str BudgetsSpent}" />
                    <TextBlock Grid.Column="3" Text="{infra:Str BudgetsProgress}" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" ToolTip="{Binding HistoryText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{Binding IndentWidth, Converter={x:Static infra:IndentConverter.Instance}}">
                                        <controls:CategoryMarker Size="10" Color="{Binding Color}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBox infra:Help.Topic="budgets.limits" Grid.Column="1" Text="{Binding LimitText, UpdateSourceTrigger=LostFocus}" Margin="8,0" TextAlignment="Right"
                                             ui:ControlHelper.PlaceholderText="—" />
                                    <TextBlock Grid.Column="2" Text="{Binding SpentText}" VerticalAlignment="Center" Opacity="0.85" />
                                    <ProgressBar Grid.Column="3" Value="{Binding Fraction, Mode=OneWay}" Style="{StaticResource BarStyle}" VerticalAlignment="Center"
                                                 Visibility="{Binding HasLimit, Converter={x:Static infra:BoolToVisibilityConverter.Visible}}" />
                                    <TextBlock Grid.Column="4" Text="{Binding PercentText}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
