<Window x:Class="BudzetDomowy.App.Views.CalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/BudzetDomowy.App;component/Assets/BudzetDomowy.ico"
        Title="{infra:Str CalcTitle}" Width="330" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" Focusable="True">
    <Window.Resources>
        <!-- keys never take the keyboard focus: typing always goes to the window -->
        <Style x:Key="Key" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="OpKey" TargetType="Button" BasedOn="{StaticResource Key}">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="26" />
        </Style>
        <Style x:Key="EqualKey" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="12,12,12,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- the display: the calculation above, the number below -->
        <Border CornerRadius="6" Padding="12,8" Margin="3,0,3,6" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel>
                <TextBlock x:Name="ExpressionLabel" Text="{Binding Expression}" HorizontalAlignment="Right" FontSize="14" Opacity="0.65" MinHeight="20" />
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right" MaxHeight="52">
                    <TextBlock x:Name="DisplayLabel" Text="{Binding Display}" FontSize="40" FontWeight="SemiBold" TextAlignment="Right" />
                </Viewbox>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="C" Style="{StaticResource OpKey}" Command="{Binding ClearCommand}" ToolTip="Del" />
            <Button Grid.Row="0" Grid.Column="1" Content="⌫" Style="{StaticResource OpKey}" Command="{Binding BackspaceCommand}" ToolTip="Backspace" />
            <Button Grid.Row="0" Grid.Column="2" Content="÷" Style="{StaticResource OpKey}" Command="{Binding OperatorCommand}" CommandParameter="/" />
            <Button Grid.Row="0" Grid.Column="3" Content="×" Style="{StaticResource OpKey}" Command="{Binding OperatorCommand}" CommandParameter="*" />

            <Button Grid.Row="1" Grid.Column="0" Content="7" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="7" />
            <Button Grid.Row="1" Grid.Column="1" Content="8" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="8" />
            <Button Grid.Row="1" Grid.Column="2" Content="9" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="9" />
            <Button Grid.Row="1" Grid.Column="3" Content="−" Style="{StaticResource OpKey}" Command="{Binding OperatorCommand}" CommandParameter="-" />

            <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="4" />
            <Button Grid.Row="2" Grid.Column="1" Content="5" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="5" />
            <Button Grid.Row="2" Grid.Column="2" Content="6" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="6" />
            <Button Grid.Row="2" Grid.Column="3" Content="+" Style="{StaticResource OpKey}" Command="{Binding OperatorCommand}" CommandParameter="+" />

            <Button Grid.Row="3" Grid.Column="0" Content="1" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="1" />
            <Button Grid.Row="3" Grid.Column="1" Content="2" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="2" />
            <Button Grid.Row="3" Grid.Column="2" Content="3" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="3" />
            <Button Grid.Row="3" Grid.Column="3" Grid.RowSpan="2" Content="=" Style="{StaticResource EqualKey}" Command="{Binding EqualCommand}" ToolTip="Enter" />

            <Button Grid.Row="4" Grid.Column="0" Content="±" Style="{StaticResource Key}" Command="{Binding NegateCommand}" />
            <Button Grid.Row="4" Grid.Column="1" Content="0" Style="{StaticResource Key}" Command="{Binding DigitCommand}" CommandParameter="0" />
            <Button Grid.Row="4" Grid.Column="2" Content="," Style="{StaticResource Key}" Command="{Binding CommaCommand}" />
        </Grid>

        <!-- the result goes to the clipboard -->
        <StackPanel Grid.Row="2" Margin="3,6,3,0">
            <Button x:Name="CopyButton" Command="{Binding CopyResultCommand}" HorizontalAlignment="Stretch" Focusable="False" Height="40" ToolTip="Ctrl+C">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{infra:Str CalcCopy}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding Note}" HorizontalAlignment="Center" FontSize="12" Margin="0,6,0,0" Opacity="0.8" MinHeight="16" />
        </StackPanel>
    </Grid>
</Window>
