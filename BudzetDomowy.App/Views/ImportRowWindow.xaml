<Window infra:Help.Topic="import.row" x:Class="BudzetDomowy.App.Views.ImportRowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        xmlns:controls="clr-namespace:BudzetDomowy.App.Controls"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/BudzetDomowy.App;component/Assets/BudzetDomowy.ico"
        Title="{infra:Str ImportRowTitle}" Width="560" SizeToContent="Height" MinWidth="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,18,24,20">
        <TextBlock Text="{infra:Str ImportRowTitle}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Heading}" Opacity="0.75" Margin="0,4,0,0" />
        <TextBlock Text="{Binding Problem}" Foreground="{StaticResource ExpenseBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Original}" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"
                   Visibility="{Binding HasOriginal, Converter={x:Static infra:BoolToVisibilityConverter.Visible}}" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DatePicker x:Name="DateBox" SelectedDate="{Binding Date, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,6,0"
                        ui:ControlHelper.Header="{infra:Str ColDate}" />
            <TextBox x:Name="AmountBox" Grid.Column="1" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0"
                     ui:ControlHelper.Header="{infra:Str ColAmount}" ui:ControlHelper.PlaceholderText="0,00" ToolTip="{infra:Str EntryAmountTip}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <RadioButton Content="{infra:Str CompareExpenses}" GroupName="rowtype" IsChecked="{Binding IsExpense, Mode=TwoWay}" MinWidth="0" />
            <RadioButton Content="{infra:Str CompareIncome}" GroupName="rowtype" IsChecked="{Binding IsIncome, Mode=TwoWay}" MinWidth="0" Margin="12,0,0,0" />
        </StackPanel>

        <TextBox Text="{Binding Place, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" ui:ControlHelper.Header="{infra:Str ColPlace}" />
        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" ui:ControlHelper.Header="{infra:Str ColNote}" />

        <controls:FilterComboBox Choices="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                 ui:ControlHelper.Header="{infra:Str ColCategory}" />
        <TextBlock Text="{Binding FileCategory}" Opacity="0.75" FontSize="12" Margin="0,4,0,0"
                   Visibility="{Binding HasFileCategory, Converter={x:Static infra:BoolToVisibilityConverter.Visible}}" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ExpenseBrush}" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="18" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{infra:Str ImportRowSkip}" Command="{Binding SkipCommand}" Margin="0,0,8,0" ToolTip="{infra:Str ImportRowSkipTip}" />
            <Button Content="{infra:Str Cancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="{infra:Str ImportRowSave}" Command="{Binding SaveCommand}" IsDefault="True" Style="{StaticResource AccentButtonStyle}" MinWidth="130" />
        </StackPanel>
    </StackPanel>
</Window>
