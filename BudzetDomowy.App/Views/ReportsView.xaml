<UserControl x:Class="BudzetDomowy.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
             xmlns:controls="clr-namespace:BudzetDomowy.App.Controls"
             xmlns:vm="clr-namespace:BudzetDomowy.App.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:BoolToVisibilityConverter x:Key="NotVis" Invert="True" />
        <infra:HexToBrushConverter x:Key="HexToBrush" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- the part that stays in place: the tabs (as in Settings) and the period -->
        <StackPanel Margin="16,8,16,0">
            <TabControl SelectedIndex="{Binding TabIndex, Mode=TwoWay}" Background="Transparent" Padding="0" Margin="0,0,0,8" BorderThickness="0">
                <TabItem Header="{infra:Str ReportTabOverview}" />
                <TabItem Header="{infra:Str ReportTabCompare}" />
                <TabItem Header="{infra:Str ReportTabPlaces}" />
            </TabControl>

            <!-- Period: everything, year, month; arrows; Excel on the right -->
            <Grid Margin="0,0,0,10" Visibility="{Binding ShowPeriod, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{infra:Str ReportAll}" IsChecked="{Binding IsAll, Mode=OneWay}" GroupName="scope"
                                 Command="{Binding SetScopeCommand}" CommandParameter="All" MinWidth="0" />
                    <RadioButton Content="{infra:Str ReportYear}" IsChecked="{Binding IsYear, Mode=OneWay}" GroupName="scope"
                                 Command="{Binding SetScopeCommand}" CommandParameter="Year" MinWidth="0" Margin="8,0,0,0" />
                    <RadioButton Content="{infra:Str ReportMonth}" IsChecked="{Binding IsMonth, Mode=OneWay}" GroupName="scope"
                                 Command="{Binding SetScopeCommand}" CommandParameter="Month" MinWidth="0" Margin="8,0,24,0" />
                    <Button Content="◀" Command="{Binding PreviousCommand}" Width="40" ToolTip="{infra:Str PeriodPrevious}"
                            Visibility="{Binding HasArrows, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" MinWidth="240" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button Content="▶" Command="{Binding NextCommand}" Width="40" ToolTip="{infra:Str PeriodNext}"
                            Visibility="{Binding HasArrows, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{infra:Str DashToday}" Command="{Binding CurrentCommand}" Margin="12,0,0,0"
                            Visibility="{Binding HasArrows, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <!-- Excel icon: the report of the period (everything: the list of all transactions) -->
                <Button Grid.Column="2" Command="{Binding ExportCommand}" ToolTip="{infra:Str ExportReportTip}" Padding="6" HorizontalAlignment="Right"
                        Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">
                    <Border Width="26" Height="26" CornerRadius="4" Background="#217346">
                        <Grid>
                            <Path Data="M5,6 L21,6 M5,11 L21,11 M5,16 L21,16 M5,21 L21,21 M11,6 L11,21" Stroke="#66FFFFFF" StrokeThickness="0.8" />
                            <TextBlock Text="X" Foreground="White" FontWeight="Black" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Button>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,0,4,12">

            <!-- ================= overview ================= -->
            <StackPanel Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">

            <!-- Summary and comparison -->
            <Border Style="{StaticResource Card}" Visibility="{Binding ShowComparison, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Heading}">
                        <Run Text="{infra:Str ReportCompareWith}" /> <Run Text="{Binding PreviousTitle, Mode=OneWay}" />
                    </TextBlock>
                    <Grid Opacity="0.7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{Binding PreviousTitle}" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{infra:Str ReportChange}" TextAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Comparison}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Current}" TextAlignment="Right" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Previous}" TextAlignment="Right" Opacity="0.8" />
                                    <TextBlock Grid.Column="3" Text="{Binding Delta}" TextAlignment="Right" x:Name="Delta" />
                                    <TextBlock Grid.Column="4" Text="{Binding Percent}" TextAlignment="Right" x:Name="Percent" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Trend}" Value="Good">
                                        <Setter TargetName="Delta" Property="Foreground" Value="{StaticResource IncomeBrush}" />
                                        <Setter TargetName="Percent" Property="Foreground" Value="{StaticResource IncomeBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Trend}" Value="Bad">
                                        <Setter TargetName="Delta" Property="Foreground" Value="{StaticResource ExpenseBrush}" />
                                        <Setter TargetName="Percent" Property="Foreground" Value="{StaticResource ExpenseBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ComparisonNote}" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.75" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Trend -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding TrendTitle}" Style="{StaticResource Heading}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-4,0,0">
                            <!-- what the charts show: everything, only the income, only the expenses -->
                            <RadioButton x:Name="TrendShowAll" Content="{infra:Str PeriodAll}" GroupName="trendshow" IsChecked="{Binding ShowsAll, Mode=OneWay}"
                                         Command="{Binding SetTrendShowCommand}" CommandParameter="All" MinWidth="0" />
                            <RadioButton x:Name="TrendShowIncome" Content="{infra:Str ReportIncome}" GroupName="trendshow" IsChecked="{Binding ShowsIncome, Mode=OneWay}"
                                         Command="{Binding SetTrendShowCommand}" CommandParameter="Income" MinWidth="0" Margin="8,0,0,0" />
                            <RadioButton x:Name="TrendShowExpenses" Content="{infra:Str ReportExpenses}" GroupName="trendshow" IsChecked="{Binding ShowsExpenses, Mode=OneWay}"
                                         Command="{Binding SetTrendShowCommand}" CommandParameter="Expense" MinWidth="0" Margin="8,0,28,0" />
                            <RadioButton Content="{infra:Str ChartColumns}" GroupName="trendstyle" IsChecked="{Binding TrendIsColumns, Mode=OneWay}"
                                         Command="{Binding SetTrendStyleCommand}" CommandParameter="Columns" MinWidth="0" />
                            <RadioButton Content="{infra:Str ChartLines}" GroupName="trendstyle" IsChecked="{Binding TrendLines, Mode=OneWay}"
                                         Command="{Binding SetTrendStyleCommand}" CommandParameter="Lines" MinWidth="0" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <lvc:CartesianChart Series="{Binding TrendSeries}" XAxes="{Binding TrendXAxes}" YAxes="{Binding TrendYAxes}"
                                            LegendPosition="Bottom" LegendTextPaint="{Binding LegendTextPaint}" Height="280" />
                        <!-- the sums of everything the chart on the left shows -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="{Binding SumTitle}" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,2" />
                            <lvc:CartesianChart Series="{Binding SumSeries}" XAxes="{Binding SumXAxes}" YAxes="{Binding SumYAxes}"
                                                LegendPosition="Bottom" LegendTextPaint="{Binding LegendTextPaint}" Height="260" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Categories -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{infra:Str ReportCategories}" Style="{StaticResource Heading}" />
                    <TextBlock Text="{infra:Str DashNoExpenses}" Opacity="0.6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBreakdown}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Visibility="{Binding HasBreakdown, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <lvc:PieChart Series="{Binding PieSeries}" LegendPosition="Hidden" Height="210" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="{infra:Str ReportTop5}" Opacity="0.7" />
                            <ItemsControl ItemsSource="{Binding TopCategories}" Margin="0,4,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <controls:CategoryMarker Size="12" Color="{Binding Color}" HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontWeight="SemiBold" Margin="8,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding ShareText}" TextAlignment="Right" Opacity="0.7" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{infra:Str ReportDrill}" Opacity="0.7" />
                            <TreeView ItemsSource="{Binding Breakdown}" MaxHeight="260" BorderThickness="0" Background="Transparent">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource DefaultTreeViewItemStyle}" />
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:BreakdownNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2,26,2">
                                            <controls:CategoryMarker Size="10" Color="{Binding Color}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" MinWidth="170" />
                                            <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" MinWidth="110" TextAlignment="Right" />
                                            <TextBlock Text="{Binding ShareText}" Opacity="0.7" MinWidth="56" TextAlignment="Right" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Averages -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{infra:Str AvgTitle}" Style="{StaticResource Heading}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Content="{infra:Str CompareExpenses}" GroupName="avgtype" IsChecked="{Binding AvgIsExpense, Mode=OneWay}"
                                     Command="{Binding SetAvgTypeCommand}" CommandParameter="Expense" MinWidth="0" />
                        <RadioButton Content="{infra:Str CompareIncome}" GroupName="avgtype" IsChecked="{Binding AvgIsIncome, Mode=OneWay}"
                                     Command="{Binding SetAvgTypeCommand}" CommandParameter="Income" MinWidth="0" Margin="8,0,20,0" />
                        <ComboBox ItemsSource="{Binding AvgChoices}" SelectedItem="{Binding AvgCategory, Mode=TwoWay}" DisplayMemberPath="Name"
                                  Width="300" ui:ControlHelper.Header="{infra:Str AvgCategory}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding AvgFrom, Mode=TwoWay}" Width="150" ui:ControlHelper.Header="{infra:Str FilterFrom}" Margin="0,0,12,0" />
                        <DatePicker SelectedDate="{Binding AvgTo, Mode=TwoWay}" Width="150" ui:ControlHelper.Header="{infra:Str FilterTo}" Margin="0,0,16,0" />
                        <CheckBox IsChecked="{Binding AvgProrate, Mode=TwoWay}" Content="{infra:Str AvgProrate}" VerticalAlignment="Bottom" ToolTip="{infra:Str AvgProrateTip}" />
                    </StackPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Margin="0,0,32,8">
                            <TextBlock Text="{infra:Str AvgPerDay}" Opacity="0.7" />
                            <TextBlock Text="{Binding AvgPerDay}" FontSize="20" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,32,8">
                            <TextBlock Text="{infra:Str AvgPerWeek}" Opacity="0.7" />
                            <TextBlock Text="{Binding AvgPerWeek}" FontSize="20" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,32,8">
                            <TextBlock Text="{infra:Str AvgPerMonth}" Opacity="0.7" />
                            <TextBlock Text="{Binding AvgPerMonth}" FontSize="20" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,32,8">
                            <TextBlock Text="{infra:Str AvgTotal}" Opacity="0.7" />
                            <TextBlock Text="{Binding AvgTotal}" FontSize="20" FontWeight="Bold" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding AvgMethod}" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
            </Border>

            <!-- Events -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasEvents, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{infra:Str ReportEvents}" Style="{StaticResource Heading}" />
                    <Grid Opacity="0.7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{infra:Str EventName}" />
                        <TextBlock Grid.Column="1" Text="{infra:Str ReportDates}" />
                        <TextBlock Grid.Column="2" Text="{infra:Str EventSpent}" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{infra:Str EventPerDay}" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{infra:Str EventPlanTitle}" TextAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Dates}" Opacity="0.8" />
                                    <TextBlock Grid.Column="2" Text="{Binding Spent}" TextAlignment="Right" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="{Binding PerDay}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding Plan}" TextAlignment="Right" Opacity="0.8" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- ================= comparisons ================= -->
            <Grid Visibility="{Binding IsCompare, Converter={StaticResource BoolToVis}}">
            <StackPanel DataContext="{Binding Compare}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <WrapPanel>
                            <RadioButton Content="{infra:Str CompareYears}" GroupName="kind" IsChecked="{Binding IsYears, Mode=OneWay}"
                                         Command="{Binding SetKindCommand}" CommandParameter="Years" MinWidth="0" />
                            <RadioButton Content="{infra:Str CompareMonths}" GroupName="kind" IsChecked="{Binding IsMonths, Mode=OneWay}"
                                         Command="{Binding SetKindCommand}" CommandParameter="Months" MinWidth="0" Margin="8,0,28,0" />
                            <RadioButton Content="{infra:Str CompareExpenses}" GroupName="ctype" IsChecked="{Binding IsExpense, Mode=OneWay}"
                                         Command="{Binding SetTypeCommand}" CommandParameter="Expense" MinWidth="0" />
                            <RadioButton Content="{infra:Str CompareIncome}" GroupName="ctype" IsChecked="{Binding IsIncome, Mode=OneWay}"
                                         Command="{Binding SetTypeCommand}" CommandParameter="Income" MinWidth="0" Margin="8,0,0,0" />
                        </WrapPanel>
                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Category, Mode=TwoWay}" DisplayMemberPath="Name"
                                  Width="360" HorizontalAlignment="Left" Margin="0,10,0,0" ui:ControlHelper.Header="{Binding CategoryLabel}" />
                        <TextBlock Text="{Binding PickLabel}" Opacity="0.7" Margin="0,10,0,4" />
                        <ItemsControl ItemsSource="{Binding Picks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" MinWidth="0" Margin="0,0,16,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-4,0,0">
                                <RadioButton Content="{infra:Str ChartColumns}" GroupName="cstyle" IsChecked="{Binding IsColumns, Mode=OneWay}"
                                             Command="{Binding SetChartStyleCommand}" CommandParameter="Columns" MinWidth="0" />
                                <RadioButton Content="{infra:Str ChartLines}" GroupName="cstyle" IsChecked="{Binding IsLines, Mode=OneWay}"
                                             Command="{Binding SetChartStyleCommand}" CommandParameter="Lines" MinWidth="0" Margin="8,0,0,0" />
                                <RadioButton Content="{infra:Str ChartAverages}" GroupName="cstyle" IsChecked="{Binding IsAverages, Mode=OneWay}"
                                             Command="{Binding SetChartStyleCommand}" CommandParameter="Averages" MinWidth="0" Margin="8,0,0,0"
                                             ToolTip="{infra:Str ChartAveragesTip}"
                                             Visibility="{Binding IsYears, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{infra:Str CompareNoData}" Opacity="0.6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasData}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <lvc:CartesianChart Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                            LegendPosition="Bottom" LegendTextPaint="{Binding LegendTextPaint}" Height="340"
                                            Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Totals}" Margin="0,12,0,0" MaxWidth="620" HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:CategoryMarker Size="12" Color="{Binding Color}" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Total}" TextAlignment="Right" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="{Binding Average}" Margin="16,0,0,0" Opacity="0.7" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>

            <!-- ================= places ================= -->
            <Grid Visibility="{Binding IsPlaces, Converter={StaticResource BoolToVis}}">
            <StackPanel DataContext="{Binding Places}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{infra:Str PlacesTitle}" Style="{StaticResource Heading}" />
                        <WrapPanel>
                            <DatePicker SelectedDate="{Binding From, Mode=TwoWay}" Width="150" ui:ControlHelper.Header="{infra:Str FilterFrom}" Margin="0,0,12,8" />
                            <DatePicker SelectedDate="{Binding To, Mode=TwoWay}" Width="150" ui:ControlHelper.Header="{infra:Str FilterTo}" Margin="0,0,20,8" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,20,8">
                                <RadioButton Content="{infra:Str CompareExpenses}" GroupName="ptype" IsChecked="{Binding IsExpense, Mode=OneWay}"
                                             Command="{Binding SetTypeCommand}" CommandParameter="Expense" MinWidth="0" />
                                <RadioButton Content="{infra:Str CompareIncome}" GroupName="ptype" IsChecked="{Binding IsIncome, Mode=OneWay}"
                                             Command="{Binding SetTypeCommand}" CommandParameter="Income" MinWidth="0" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                     ui:ControlHelper.PlaceholderText="{infra:Str PlacesSearch}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                                      GridLinesVisibility="All" MaxHeight="520" Width="620" HorizontalAlignment="Left"
                                      AlternationCount="2" AlternatingRowBackground="{DynamicResource SystemControlBackgroundListLowBrush}"
                                      infra:GridBehaviors.ColumnChooserKey="places"
                                      infra:GridBehaviors.AutoFit="{Binding AutoFitColumns, Source={x:Static infra:UiPreferences.Instance}}"
                                      Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{infra:Str PlacesColName}" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="{infra:Str PlacesColCount}" Binding="{Binding Count}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{infra:Str PlacesColAmount}" Binding="{Binding Amount, StringFormat=C2}" Width="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{infra:Str PlacesColShare}" Binding="{Binding Share, StringFormat=P1}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Right" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Opacity" Value="0.7" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- the entries counted in the selected place's total: to look at only -->
                            <StackPanel Grid.Column="2" x:Name="PlaceDetails">
                                <TextBlock Text="{Binding DetailsTitle}" FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{infra:Str PlacesPickOne}" Opacity="0.6" TextWrapping="Wrap"
                                           Visibility="{Binding HasDetails, Converter={StaticResource NotVis}}" />
                                <DataGrid x:Name="PlaceDetailsGrid" ItemsSource="{Binding Details}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="All"
                                          MaxHeight="520" AlternationCount="2" AlternatingRowBackground="{DynamicResource SystemControlBackgroundListLowBrush}"
                                          infra:GridBehaviors.ColumnChooserKey="place-details"
                                          Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{infra:Str ColDate}" Binding="{Binding Date, StringFormat=d}" Width="100" />
                                        <DataGridTextColumn Header="{infra:Str ColAmount}" Binding="{Binding Amount, StringFormat=C2}" Width="110">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="{infra:Str ColCategory}" Binding="{Binding Category}" Width="*" />
                                        <DataGridTextColumn Header="{infra:Str ColNote}" Binding="{Binding Note}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
