<UserControl x:Class="BudzetDomowy.App.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:BoolToVisibilityConverter x:Key="NotVis" Invert="True" />
    </UserControl.Resources>
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="{infra:Str PayAddButton}" Command="{Binding AddPaymentsCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" />
            <Button Content="{infra:Str PayPayees}" Command="{Binding ManagePayeesCommand}" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{Binding Summary}" FontWeight="SemiBold" Margin="0,0,0,8" />

        <DataGrid Grid.Row="2" x:Name="PaymentGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  GridLinesVisibility="All" RowHeight="46" AlternationCount="2" AlternatingRowBackground="{DynamicResource SystemControlBackgroundListLowBrush}"
                  infra:GridBehaviors.ColumnChooserKey="payments"
                  infra:GridBehaviors.AutoFit="{Binding AutoFitColumns, Source={x:Static infra:UiPreferences.Instance}}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{infra:Str PayColDue}" Width="200" SortMemberPath="Payment.DueDate">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="{Binding DueText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Relative}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Opacity" Value="0.7" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLate}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource ExpenseBrush}" />
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{infra:Str PayPayee}" Width="1.4*" SortMemberPath="PayeeName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="{Binding PayeeName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Account}" FontFamily="Consolas" FontSize="11" Opacity="0.65" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{infra:Str PayColTitle}" Binding="{Binding Title}" Width="1.6*" />
                <DataGridTemplateColumn Header="{infra:Str PayColAmount}" Width="130" SortMemberPath="Payment.Amount">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AmountText}" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{infra:Str PayColStatus}" Width="130" SortMemberPath="StatusText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScheduled}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="180" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="{infra:Str PayButton}" Style="{StaticResource AccentButtonStyle}" Padding="16,4" MinWidth="0"
                                        Command="{Binding DataContext.PayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <Button Content="✕" Margin="8,0,0,0" Padding="0" Width="32" Height="32" MinWidth="0" ToolTip="{infra:Str PayDeleteTip}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{infra:Str PayEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" TextAlignment="Center" IsHitTestVisible="False"
                   Visibility="{Binding HasItems, Converter={StaticResource NotVis}}" />
    </Grid>
</UserControl>
