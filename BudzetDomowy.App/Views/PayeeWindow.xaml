<Window infra:Help.Topic="payments.payees" x:Class="BudzetDomowy.App.Views.PayeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        xmlns:controls="clr-namespace:BudzetDomowy.App.Controls"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/BudzetDomowy.App;component/Assets/BudzetDomowy.ico"
        Title="{Binding Title}" Width="560" SizeToContent="Height" MinWidth="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown">
    <StackPanel Margin="24,18,24,20">
        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 ui:ControlHelper.Header="{infra:Str PayeeName}" ui:ControlHelper.PlaceholderText="{infra:Str PayeeNameHint}" />

        <!-- the number: typed in any way, shown in the standard groups once the box is left -->
        <TextBox infra:Help.Topic="payments.payees" x:Name="AccountBox" Text="{Binding AccountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" FontFamily="Consolas" FontSize="16"
                 ui:ControlHelper.Header="{infra:Str PayeeAccount}" ui:ControlHelper.PlaceholderText="00 0000 0000 0000 0000 0000 0000"
                 LostFocus="AccountBox_LostFocus" />
        <TextBlock x:Name="AccountHint" Text="{Binding AccountHint}" Margin="0,4,0,0" FontSize="12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Opacity" Value="0.75" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AccountState}" Value="Ok">
                            <Setter Property="Foreground" Value="{StaticResource IncomeBrush}" />
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AccountState}" Value="Bad">
                            <Setter Property="Foreground" Value="{StaticResource ExpenseBrush}" />
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <controls:FilterComboBox x:Name="CategoryBox" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                                 Choices="{Binding Categories}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding CategoryId, Mode=TwoWay}"
                                 ui:ControlHelper.Header="{infra:Str PayeeCategory}" ui:ControlHelper.PlaceholderText="{infra:Str PayeeCategoryHint}" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ExpenseBrush}" TextWrapping="Wrap" Margin="0,10,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{infra:Str Cancel}" Click="Cancel_Click" MinWidth="110" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="{infra:Str CategorySave}" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" MinWidth="130" />
        </StackPanel>
    </StackPanel>
</Window>
