<UserControl x:Class="BudzetDomowy.App.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
             xmlns:controls="clr-namespace:BudzetDomowy.App.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:HexToBrushConverter x:Key="HexToBrush" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,12,16,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- List -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button Content="{infra:Str EventAdd}" Command="{Binding AddEventCommand}" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch" Margin="0,0,0,10" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                     HorizontalContentAlignment="Stretch" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="3" Background="{Binding Color, Converter={StaticResource HexToBrush}}" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Dates}" Opacity="0.7" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Status}" Opacity="0.7" />
                                    <TextBlock Text=" · " Opacity="0.7" />
                                    <TextBlock Text="{Binding Spent}" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="1" Text="{infra:Str EventsEmpty}" TextWrapping="Wrap" Opacity="0.6" Margin="8,12"
                       VerticalAlignment="Top" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Details -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Editor -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"
                                     ui:ControlHelper.Header="{infra:Str EventName}" />
                            <DatePicker Grid.Column="2" SelectedDate="{Binding EditFrom, Mode=TwoWay}" Width="150"
                                        ui:ControlHelper.Header="{infra:Str EventFrom}" />
                            <DatePicker Grid.Column="4" SelectedDate="{Binding EditTo, Mode=TwoWay}" Width="150"
                                        ui:ControlHelper.Header="{infra:Str EventTo}" />
                            <TextBox Grid.Column="6" Text="{Binding EditPlanned, UpdateSourceTrigger=PropertyChanged}"
                                     ui:ControlHelper.Header="{infra:Str EventPlannedField}" ui:ControlHelper.PlaceholderText="{infra:Str EventPlannedHint}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ColorPalette}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="26" Height="26" Margin="0,0,6,6" Padding="0" MinWidth="0" MinHeight="0"
                                            Background="{Binding Converter={StaticResource HexToBrush}}"
                                            Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                                 ui:ControlHelper.Header="{infra:Str EventNote}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{infra:Str CategorySave}" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="{infra:Str CategoryRemove}" Command="{Binding DeleteCommand}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Figures -->
                <WrapPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{infra:Str EventSpent}" Opacity="0.7" />
                            <TextBlock Text="{Binding ExpenseText}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ExpenseBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{infra:Str EventPerDay}" Opacity="0.7" />
                            <TextBlock Text="{Binding PerDayText}" FontSize="24" FontWeight="Bold" />
                            <TextBlock Opacity="0.7">
                                <Run Text="{infra:Str EventDays}" /> <Run Text="{Binding DaysText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{infra:Str EventIncomeRefunds}" Opacity="0.7" />
                            <TextBlock Text="{Binding IncomeText}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource IncomeBrush}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Plan comparison -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{infra:Str EventPlanTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PlanText}" Margin="0,4,0,0" />
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding PlanFraction}" Height="10" Margin="0,8,0,0"
                                     Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
                                    <Setter Property="Foreground" Value="{StaticResource IncomeBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverPlan}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ExpenseBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Text="{Binding RemainingText}" Margin="0,6,0,0" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <!-- Categories -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasSlices, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <lvc:PieChart Series="{Binding PieSeries}" LegendPosition="Hidden" Height="240" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Slices}" VerticalAlignment="Center" Margin="12,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <controls:CategoryMarker Size="12" Color="{Binding Color}" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontWeight="SemiBold" Margin="8,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding ShareText}" TextAlignment="Right" Opacity="0.7" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Transactions -->
                <TextBlock Text="{infra:Str EventTransactions}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <DataGrid infra:GridBehaviors.ColumnChooserKey="event-transactions" infra:GridBehaviors.AutoFit="{Binding AutoFitColumns, Source={x:Static infra:UiPreferences.Instance}}" ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="420" Margin="0,0,12,16"
                          AlternationCount="2" AlternatingRowBackground="{DynamicResource SystemControlBackgroundListLowBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{infra:Str ColDate}" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="110" />
                        <DataGridTextColumn Header="{infra:Str ColAmount}" Binding="{Binding AmountDisplay}" Width="200" />
                        <DataGridTextColumn Header="{infra:Str ColCategory}" Binding="{Binding Category}" Width="*" />
                        <DataGridTextColumn Header="{infra:Str ColPlace}" Binding="{Binding Place}" Width="*" />
                        <DataGridTextColumn Header="{infra:Str ColNote}" Binding="{Binding Note}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Column="2" Text="{infra:Str EventPickOne}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelection}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
