<Window infra:Help.Topic="entry.income" x:Class="BudzetDomowy.App.Views.IncomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        xmlns:controls="clr-namespace:BudzetDomowy.App.Controls"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/BudzetDomowy.App;component/Assets/BudzetDomowy.ico"
        Title="{Binding Title}" Width="560" SizeToContent="Height" MinWidth="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <StackPanel Margin="24,18,24,20">
        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- date, amount, currency -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <DatePicker infra:Help.Topic="entry.date" x:Name="DateBox" SelectedDate="{Binding Date, Mode=TwoWay}" Margin="0,0,10,0" HorizontalAlignment="Stretch"
                        ui:ControlHelper.Header="{infra:Str QuickDate}" />
            <controls:ExpressionBox infra:Help.Topic="entry.total" x:Name="AmountBox" Grid.Column="1" Expression="{Binding TotalText, Mode=TwoWay}" DisplayText="{Binding TotalDisplay}"
                                    Margin="0,0,10,0" TextAlignment="Right" ToolTip="{infra:Str EntryAmountTip}"
                                    ui:ControlHelper.Header="{infra:Str QuickAmount}" ui:ControlHelper.PlaceholderText="0,00" />
            <ComboBox infra:Help.Topic="entry.currency" x:Name="CurrencyBox" Grid.Column="2" ItemsSource="{Binding Currencies}" DisplayMemberPath="Code" SelectedValuePath="Code"
                      SelectedValue="{Binding CurrencyCode, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      ui:ControlHelper.Header="{infra:Str QuickCurrency}" ToolTip="{infra:Str QuickCurrencyTip}" />
        </Grid>

        <!-- exchange rate: only for a foreign currency -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsForeign, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{infra:Str RateLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="100" IsTabStop="False" Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{infra:Str RateTip}" />
            <Button Content="↻" Command="{Binding ResetRateCommand}" Margin="6,0,0,0" IsTabStop="False" ToolTip="{infra:Str RateReset}" />
            <TextBlock Text="{Binding RateInfo}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8" />
            <TextBlock Text="{Binding ConvertedText}" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold"
                       Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
        </StackPanel>

        <controls:FilterComboBox x:Name="CategoryBox" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                 Choices="{Binding Categories}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                 SelectedValue="{Binding Main.CategoryId, Mode=TwoWay}"
                                 ui:ControlHelper.Header="{infra:Str QuickCategory}" ui:ControlHelper.PlaceholderText="{infra:Str QuickCategoryHint}" />

        <TextBox infra:Help.Topic="entry.note" x:Name="NoteBox" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"
                 ui:ControlHelper.Header="{infra:Str QuickNote}" ui:ControlHelper.PlaceholderText="{infra:Str QuickNoteHint}" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ExpenseBrush}" TextWrapping="Wrap" Margin="0,10,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{infra:Str Cancel}" Click="Cancel_Click" MinWidth="110" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Content="{infra:Str EntryConfirm}" Click="Confirm_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="130"
                    ToolTip="{infra:Str QuickAddTip}" />
        </StackPanel>
    </StackPanel>
</Window>
