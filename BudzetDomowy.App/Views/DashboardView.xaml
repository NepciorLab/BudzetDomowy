<UserControl infra:Help.Topic="dashboard" x:Class="BudzetDomowy.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
             xmlns:controls="clr-namespace:BudzetDomowy.App.Controls">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:HexToBrushConverter x:Key="HexToBrush" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        </Style>
        <Style x:Key="BudgetBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource IncomeBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Over">
                    <Setter Property="Foreground" Value="{StaticResource ExpenseBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,12,4,12">
            <!-- Month switch -->
            <StackPanel infra:Help.Topic="dashboard.month" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="◀" Command="{Binding PreviousMonthCommand}" Width="40" ToolTip="{Binding PreviousTip}" />
                <!-- the title opens a list of months and years, to get far back at once -->
                <Grid Width="260">
                    <Button x:Name="MonthPickerButton" Command="{Binding TogglePickerCommand}" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,2" ToolTip="{Binding PickTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MonthTitle}" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="▾" FontSize="14" Opacity="0.6" VerticalAlignment="Center" Margin="8,4,0,0" />
                        </StackPanel>
                    </Button>
                    <Popup x:Name="MonthPicker" IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                        <Border Margin="8" Padding="10" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.35" />
                            </Border.Effect>
                            <StackPanel Width="236">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="«" Command="{Binding ShiftPickerYearCommand}" CommandParameter="-10" IsEnabled="{Binding CanPickerGoBack}"
                                            Width="40" ToolTip="{infra:Str DashYearBack10}" />
                                    <Button Grid.Column="1" Content="‹" Command="{Binding ShiftPickerYearCommand}" CommandParameter="-1" IsEnabled="{Binding CanPickerGoBack}"
                                            Width="36" Margin="4,0,0,0" ToolTip="{infra:Str DashYearBack1}" />
                                    <TextBlock Grid.Column="2" Text="{Binding PickerTitle}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Content="›" Command="{Binding ShiftPickerYearCommand}" CommandParameter="1" IsEnabled="{Binding CanPickerGoForward}"
                                            Width="36" Margin="0,0,4,0" ToolTip="{infra:Str DashYearForward1}" />
                                    <Button Grid.Column="4" Content="»" Command="{Binding ShiftPickerYearCommand}" CommandParameter="10" IsEnabled="{Binding CanPickerGoForward}"
                                            Width="40" ToolTip="{infra:Str DashYearForward10}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PickerMonths}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}" Margin="2" HorizontalAlignment="Stretch" Padding="0,6"
                                                    Command="{Binding DataContext.PickMonthCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Number}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasData}" Value="False">
                                                                <Setter Property="Opacity" Value="0.55" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <Button Content="▶" Command="{Binding NextMonthCommand}" Width="40" ToolTip="{Binding NextTip}" />
                <Button Content="{infra:Str DashToday}" Command="{Binding ThisMonthCommand}" Margin="12,0,0,0" />
                <!-- the same screen for a month or for the whole year -->
                <RadioButton Content="{infra:Str PeriodMonth}" GroupName="dashmode" IsChecked="{Binding IsMonthMode, Mode=OneWay}"
                             Command="{Binding SetModeCommand}" CommandParameter="Month" MinWidth="0" Margin="24,0,0,0" infra:Help.Topic="dashboard.mode" />
                <RadioButton Content="{infra:Str PeriodYear}" GroupName="dashmode" IsChecked="{Binding IsYear, Mode=OneWay}"
                             Command="{Binding SetModeCommand}" CommandParameter="Year" MinWidth="0" Margin="6,0,0,0" infra:Help.Topic="dashboard.mode" />
            </StackPanel>

            <!-- Tiles -->
            <WrapPanel>
                <Border infra:Help.Topic="dashboard.tiles" Style="{StaticResource Card}" MinWidth="220">
                    <StackPanel>
                        <TextBlock Text="{infra:Str DashIncome}" Opacity="0.7" />
                        <TextBlock Text="{Binding IncomeText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource IncomeBrush}" />
                        <TextBlock Text="{Binding IncomeChange}" Opacity="0.7" ToolTip="{Binding ChangeTip}" ToolTipService.IsEnabled="{Binding HasChangeTip}" />
                    </StackPanel>
                </Border>
                <Border infra:Help.Topic="dashboard.tiles" Style="{StaticResource Card}" MinWidth="220">
                    <StackPanel>
                        <TextBlock Text="{infra:Str DashExpenses}" Opacity="0.7" />
                        <TextBlock Text="{Binding ExpenseText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource ExpenseBrush}" />
                        <TextBlock Text="{Binding ExpenseChange}" Opacity="0.7" ToolTip="{Binding ChangeTip}" ToolTipService.IsEnabled="{Binding HasChangeTip}" />
                    </StackPanel>
                </Border>
                <Border infra:Help.Topic="dashboard.tiles" Style="{StaticResource Card}" MinWidth="220">
                    <StackPanel>
                        <TextBlock Text="{infra:Str DashBalance}" Opacity="0.7" />
                        <TextBlock Text="{Binding BalanceText}" FontSize="26" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource IncomeBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BalanceNegative}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ExpenseBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Expenses by category: the whole width -->
            <Border infra:Help.Topic="dashboard.chart" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="←" Command="{Binding BackCommand}" Margin="0,0,10,0"
                                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" ToolTip="{infra:Str DashBack}" />
                        <TextBlock Text="{Binding ChartTitle}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{infra:Str DashNoExpenses}" Opacity="0.6" Margin="0,16" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSlices}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- the height and the width of the three parts do not depend on the month, so the charts do not move sideways or jump while they change -->
                    <Grid Margin="0,8,0,0" Height="{Binding ChartAreaHeight}" Visibility="{Binding HasSlices, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="400" />
                            <ColumnDefinition Width="*" MinWidth="260" />
                        </Grid.ColumnDefinitions>
                        <controls:DonutChart x:Name="CategoryRing" Items="{Binding ChartItems}" Height="220" VerticalAlignment="Center"
                                             RingThickness="{Binding ChartRingThickness, Source={x:Static infra:UiPreferences.Instance}}" />
                        <!-- the legend: the figures stand next to the names; room for the chosen number of categories, then it scrolls -->
                        <ScrollViewer Grid.Column="1" VerticalAlignment="Center" Height="{Binding LegendHeight}" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Margin="8,0,16,0">
                        <ItemsControl ItemsSource="{Binding Slices}" VerticalAlignment="Center" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.DrillIntoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Background="Transparent" Height="27" MinHeight="0"
                                            BorderThickness="0" Padding="4,0" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" ToolTip="{infra:Str DashDrillTip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LegendName" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LegendAmount" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LegendShare" />
                                                <ColumnDefinition Width="14" />
                                            </Grid.ColumnDefinitions>
                                            <controls:CategoryMarker Size="12" Color="{Binding Color}" HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" MaxWidth="190" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontWeight="SemiBold" TextAlignment="Right" Margin="14,0,0,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding ShareText}" TextAlignment="Right" Opacity="0.7" Margin="10,0,0,0" />
                                            <TextBlock Grid.Column="4" Text="›" Opacity="0.7" HorizontalAlignment="Right"
                                                       Visibility="{Binding CanDrill, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                        <!-- the same expenses as bars, at the left edge: they grow and shrink in place when another month is shown; too many of them scroll -->
                        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <controls:BarBreakdownChart x:Name="CategoryBars" Items="{Binding ChartItems}" Margin="0,0,0,14"
                                                        BarWidth="{Binding ChartBarWidth, Source={x:Static infra:UiPreferences.Instance}}"
                                                        GapPercent="{Binding ChartBarGap, Source={x:Static infra:UiPreferences.Instance}}"
                                                        BreakLargest="{Binding ChartBreakLargest, Source={x:Static infra:UiPreferences.Instance}}"
                                                        BreakBrush="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
                        </ScrollViewer>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- below them: the recent entries and, beside them, the budgets -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <!-- Recent entries -->
                <Border infra:Help.Topic="dashboard.recent" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{infra:Str DashRecent}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Date, StringFormat='dd.MM.yyyy'}" Opacity="0.7" />
                                        <TextBlock Grid.Column="1" Text="{Binding Place}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <controls:CategoryMarker Size="10" Color="{Binding CategoryColor}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Category}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding AmountText}" TextAlignment="Right" FontWeight="SemiBold"
                                                   Style="{StaticResource AmountText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Budgets and the active event -->
                <StackPanel Grid.Column="1">
                    <Border infra:Help.Topic="dashboard.budgets" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding BudgetsTitle}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="{infra:Str DashNoBudgets}" Opacity="0.6" Margin="0,8,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBudgets}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding BudgetBars}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,6">
                                            <Grid>
                                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,0,70,0" />
                                                <TextBlock Text="{Binding PercentText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            </Grid>
                                            <ProgressBar Value="{Binding Fraction, Mode=OneWay}" Style="{StaticResource BudgetBarStyle}" Margin="0,4" />
                                            <TextBlock Text="{Binding Text}" Opacity="0.7" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border infra:Help.Topic="dashboard.event" Style="{StaticResource Card}" Visibility="{Binding HasActiveEvent, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{infra:Str DashActiveEvent}" Opacity="0.7" />
                            <TextBlock Text="{Binding EventName}" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding EventDates}" Opacity="0.7" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding EventSpent}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ExpenseBrush}" />
                                <TextBlock Text="{Binding EventPerDay}" Margin="12,0,0,0" VerticalAlignment="Bottom" Opacity="0.7" />
                            </StackPanel>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding EventFraction, Mode=OneWay}" Height="8" Margin="0,8,0,0"
                                         Visibility="{Binding EventHasPlan, Converter={StaticResource BoolToVis}}">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBarStyle}">
                                        <Setter Property="Foreground" Value="{StaticResource IncomeBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EventOver}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ExpenseBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Text="{Binding EventPlan}" Opacity="0.7" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
