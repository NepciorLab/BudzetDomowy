<Window x:Class="BudzetDomowy.App.Views.PayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/BudzetDomowy.App;component/Assets/BudzetDomowy.ico"
        Title="{infra:Str PayWindowTitle}" Width="780" SizeToContent="Height" MinWidth="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="24,18,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- the QR code: white with a quiet zone, to be scanned by the bank's application -->
        <StackPanel Margin="0,0,24,0" Width="290">
            <Border Background="White" CornerRadius="6" Padding="6" HorizontalAlignment="Center">
                <Image x:Name="QrPicture" Source="{Binding Qr}" Width="270" Height="270" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <TextBlock Text="{infra:Str QrHint}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,8,0,0" />
            <TextBlock Text="{Binding QrNote}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,6,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBlock Text="{infra:Str PayWindowTitle}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding AmountText}" FontSize="30" FontWeight="Bold" Margin="0,10,0,0" Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />

            <TextBlock Text="{infra:Str PayPayee}" Opacity="0.7" Margin="0,14,0,0" />
            <TextBlock Text="{Binding PayeeName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

            <TextBlock Text="{infra:Str PayeeAccount}" Opacity="0.7" Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding AccountFormatted}" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center" />
                <Button Content="{infra:Str PayCopy}" Command="{Binding CopyAccountCommand}" Margin="10,0,0,0" Padding="10,2" MinWidth="0" />
            </StackPanel>

            <TextBlock Text="{infra:Str PayColTitle}" Opacity="0.7" Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxWidth="330" VerticalAlignment="Center" />
                <Button Content="{infra:Str PayCopy}" Command="{Binding CopyTitleCommand}" Margin="10,0,0,0" Padding="10,2" MinWidth="0" />
            </StackPanel>

            <TextBlock Text="{infra:Str PayColDue}" Opacity="0.7" Margin="0,10,0,0" />
            <TextBlock>
                <Run Text="{Binding DueText, Mode=OneWay}" /> · <Run Text="{Binding Relative, Mode=OneWay}" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <Button Content="{infra:Str PayCopyAmount}" Command="{Binding CopyAmountCommand}" Padding="10,2" MinWidth="0" />
            </StackPanel>

            <TextBlock Text="{infra:Str PayScheduledNow}" Foreground="{DynamicResource SystemControlForegroundAccentBrush}" Margin="0,12,0,0"
                       Visibility="{Binding IsScheduled, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{infra:Str PayBackToPending}" Command="{Binding BackToPendingCommand}" Margin="0,0,8,0"
                    Visibility="{Binding IsScheduled, Converter={StaticResource BoolToVis}}" />
            <Button Content="{infra:Str PayMarkScheduled}" Command="{Binding MarkScheduledCommand}" Margin="0,0,8,0"
                    Visibility="{Binding IsScheduled, Converter={x:Static infra:BoolToVisibilityConverter.Hidden}}" ToolTip="{infra:Str PayMarkScheduledTip}" />
            <Button Content="{infra:Str PayMarkPaid}" Command="{Binding MarkPaidCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" ToolTip="{infra:Str PayMarkPaidTip}" />
            <Button Content="{infra:Str Close}" Command="{Binding CloseCommand}" IsCancel="True" MinWidth="100" />
        </StackPanel>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
    </Grid>
</Window>
