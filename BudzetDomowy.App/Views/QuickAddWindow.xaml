<Window x:Class="BudzetDomowy.App.Views.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        xmlns:views="clr-namespace:BudzetDomowy.App.Views"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/BudzetDomowy.App;component/Assets/BudzetDomowy.ico"
        Title="{infra:Str QuickWindowTitle}" Width="1220" SizeToContent="Height" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        PreviewKeyDown="OnPreviewKeyDown">
    <views:QuickAddBar x:Name="Bar" />
</Window>
