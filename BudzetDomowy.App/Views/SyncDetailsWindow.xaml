<Window x:Class="BudzetDomowy.App.Views.SyncDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/Assets/BudzetDomowy.ico"
        Title="{infra:Str SyncDetailsTitle}" Width="720" Height="560" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Summary}" FontSize="20" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="{infra:Str SyncDetailsFolder}" Opacity="0.7" />
            <TextBlock Text="{Binding DataFolder}" TextWrapping="Wrap" IsHitTestVisible="True" />
            <TextBlock Text="{infra:Str SyncDetailsLocal}" Opacity="0.7" Margin="0,8,0,0" />
            <TextBlock Text="{Binding LocalFolder}" TextWrapping="Wrap" />
            <TextBlock Text="{infra:Str SyncDetailsThisDevice}" Opacity="0.7" Margin="0,8,0,0" />
            <TextBlock Text="{Binding ThisDevice}" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{infra:Str SyncDetailsIssues}" FontWeight="SemiBold" Margin="0,16,0,6" />
        <ListBox Grid.Row="3" ItemsSource="{Binding Issues}" MinHeight="60">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="4" Text="{infra:Str SyncDetailsDevices}" FontWeight="SemiBold" Margin="0,16,0,6" />
        <DataGrid Grid.Row="5" ItemsSource="{Binding Devices}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" MinHeight="70">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{infra:Str SyncColDevice}" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="{infra:Str SyncColEvents}" Binding="{Binding EventCount}" Width="Auto" />
                <DataGridTextColumn Header="{infra:Str SyncColLastRead}" Binding="{Binding LastRead}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{infra:Str SyncOpenFolder}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" />
            <Button Content="{infra:Str SyncNow}" Command="{Binding SyncNowCommand}" Margin="0,0,8,0"
                    Style="{StaticResource AccentButtonStyle}" />
            <Button Content="{infra:Str Close}" IsCancel="True" IsDefault="True" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
