<UserControl x:Class="BudzetDomowy.App.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
             xmlns:controls="clr-namespace:BudzetDomowy.App.Controls"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:HexToBrushConverter x:Key="HexToBrush" />
        <infra:BoolToVisibilityConverter x:Key="NotVis" Invert="True" />
    </UserControl.Resources>
    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Period: week, month, year or free range, with arrows; Excel export on the right -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="{infra:Str PeriodWeek}" GroupName="mode" IsChecked="{Binding IsWeekMode, Mode=OneWay}"
                             Command="{Binding SetModeCommand}" CommandParameter="Week" MinWidth="0" />
                <RadioButton Content="{infra:Str PeriodMonth}" GroupName="mode" IsChecked="{Binding IsMonthMode, Mode=OneWay}"
                             Command="{Binding SetModeCommand}" CommandParameter="Month" MinWidth="0" Margin="6,0,0,0" />
                <RadioButton Content="{infra:Str PeriodYear}" GroupName="mode" IsChecked="{Binding IsYearMode, Mode=OneWay}"
                             Command="{Binding SetModeCommand}" CommandParameter="Year" MinWidth="0" Margin="6,0,0,0" />
                <RadioButton Content="{infra:Str PeriodAll}" GroupName="mode" IsChecked="{Binding IsAllMode, Mode=OneWay}"
                             Command="{Binding SetModeCommand}" CommandParameter="All" MinWidth="0" Margin="6,0,0,0" />
                <RadioButton Content="{infra:Str PeriodRange}" GroupName="mode" IsChecked="{Binding IsRangeMode, Mode=OneWay}"
                             Command="{Binding SetModeCommand}" CommandParameter="Range" MinWidth="0" Margin="6,0,20,0" />
                <Button Content="◀" Command="{Binding PreviousCommand}" Width="40" ToolTip="{infra:Str PeriodPrevious}"
                        Visibility="{Binding HasArrows, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding PeriodTitle}" FontSize="20" FontWeight="SemiBold" MinWidth="230" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Content="▶" Command="{Binding NextCommand}" Width="40" ToolTip="{infra:Str PeriodNext}"
                        Visibility="{Binding HasArrows, Converter={StaticResource BoolToVis}}" />
                <Button Content="{infra:Str DashToday}" Command="{Binding TodayCommand}" Margin="12,0,0,0"
                        Visibility="{Binding HasArrows, Converter={StaticResource BoolToVis}}" />
                <DatePicker SelectedDate="{Binding From, Mode=TwoWay}" Width="140" Margin="8,0,0,0" ui:ControlHelper.PlaceholderText="{infra:Str FilterFrom}"
                            Visibility="{Binding IsRangeMode, Converter={StaticResource BoolToVis}}" />
                <DatePicker SelectedDate="{Binding To, Mode=TwoWay}" Width="140" Margin="8,0,0,0" ui:ControlHelper.PlaceholderText="{infra:Str FilterTo}"
                            Visibility="{Binding IsRangeMode, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <!-- Excel icon: exports what the table shows -->
            <Button Grid.Column="2" Command="{Binding ExportXlsxCommand}" ToolTip="{infra:Str ExportVisibleTip}" Padding="6" HorizontalAlignment="Right">
                <Border Width="26" Height="26" CornerRadius="4" Background="#217346">
                    <Grid>
                        <Path Data="M5,6 L21,6 M5,11 L21,11 M5,16 L21,16 M5,21 L21,21 M11,6 L11,21" Stroke="#66FFFFFF" StrokeThickness="0.8" />
                        <TextBlock Text="X" Foreground="White" FontWeight="Black" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Button>
        </Grid>

        <!-- Filters -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal">
            <controls:FilterComboBox Choices="{Binding FilterCategories}" DisplayMemberPath="DisplayName"
                                     SelectedValuePath="Id" SelectedValue="{Binding CategoryFilter, Mode=TwoWay}"
                                     Width="230" Margin="0,0,8,8"
                                     ui:ControlHelper.Header="{infra:Str FilterCategory}"
                                     ui:ControlHelper.PlaceholderText="{infra:Str FilterAllCategories}" />
            <ComboBox ItemsSource="{Binding FilterEvents}" DisplayMemberPath="Name" SelectedValuePath="Key"
                      SelectedValue="{Binding EventFilter, Mode=TwoWay}" Width="160" Margin="0,0,8,8"
                      ui:ControlHelper.Header="{infra:Str FilterEvent}" />
            <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding TypeFilter, Mode=TwoWay}" Width="130" Margin="0,0,8,8"
                      ui:ControlHelper.Header="{infra:Str FilterType}" />
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,8"
                     ui:ControlHelper.Header="{infra:Str FilterSearch}"
                     ui:ControlHelper.PlaceholderText="{infra:Str FilterSearchHint}" />
            <Button Content="{infra:Str FilterClear}" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
        </WrapPanel>

        <!-- Table -->
        <!-- invisible anchor of the "change category" flyout (the flyout service only works on a button) -->
        <Button x:Name="FlyoutAnchor" Grid.Row="2" Width="1" Height="1" MinWidth="0" MinHeight="0" Padding="0" Opacity="0" Focusable="False"
                IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
                    <ui:FlyoutService.Flyout>
                        <ui:Flyout x:Name="BulkFlyout" Opening="BulkFlyout_Opening" Placement="Bottom">
                            <StackPanel Width="320">
                                <controls:FilterComboBox x:Name="BulkCombo" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                                         HorizontalAlignment="Stretch"
                                                         ui:ControlHelper.Header="{infra:Str BulkNewCategory}"
                                                         ui:ControlHelper.PlaceholderText="{infra:Str QuickCategoryHint}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button Content="{infra:Str Cancel}" Click="BulkCancel_Click" Margin="0,0,8,0" />
                                    <Button Content="{infra:Str BulkApply}" Click="BulkApply_Click" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Flyout>
                    </ui:FlyoutService.Flyout>
        </Button>
        <DataGrid x:Name="Grid" Grid.Row="2" ItemsSource="{Binding Rows}"
                  infra:GridBehaviors.ColumnChooserKey="transactions"
                  infra:GridBehaviors.AutoFit="{Binding AutoFitColumns, Source={x:Static infra:UiPreferences.Instance}}" AutoGenerateColumns="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  EnableRowVirtualization="True" RowHeight="34" ClipboardCopyMode="ExcludeHeader"
                  AlternationCount="2" AlternatingRowBackground="{DynamicResource SystemControlBackgroundListLowBrush}"
                  BeginningEdit="Grid_BeginningEdit" CellEditEnding="Grid_CellEditEnding"
                  SelectionChanged="Grid_SelectionChanged" PreviewKeyDown="Grid_PreviewKeyDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{infra:Str BulkChangeCategory}" Click="MenuChangeCategory_Click" />
                    <MenuItem Header="{infra:Str BulkDelete}" InputGestureText="Del" Click="MenuDelete_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{infra:Str ColDate}" Width="130" SortMemberPath="Date">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Date, StringFormat='dd.MM.yyyy ddd'}" VerticalAlignment="Center" Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding Date, Mode=TwoWay}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{infra:Str ColType}" Width="100" SortMemberPath="IsIncome">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TypeChoice.Label}" VerticalAlignment="Center" Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.TypeChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      SelectedItem="{Binding TypeChoice, Mode=TwoWay}" DisplayMemberPath="Label"
                                      VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{infra:Str ColAmount}" Width="130" SortMemberPath="Model.AmountPln">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AmountDisplay}" TextAlignment="Right" VerticalAlignment="Center"
                                       Margin="8,0" FontWeight="SemiBold">
                                <TextBlock.Foreground>
                                    <MultiBinding Converter="{x:Static infra:AmountBrushConverter.Instance}">
                                        <Binding Path="IsIncome" />
                                        <Binding Path="ColorAmounts" Source="{x:Static infra:UiPreferences.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding AmountText, UpdateSourceTrigger=LostFocus}" TextAlignment="Right" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{infra:Str ColOriginal}" Width="170" IsReadOnly="True" SortMemberPath="Model.Amount">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding OriginalDisplay}" VerticalAlignment="Center" Margin="8,0" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OriginalDisplay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{infra:Str ColCategory}" Width="2*" SortMemberPath="CategoryPath">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <controls:CategoryMarker Size="10" Color="{Binding CategoryColor}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding CategoryIcon}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding CategoryPath}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <controls:FilterComboBox Choices="{Binding Choices}" DisplayMemberPath="DisplayName"
                                                     SelectedValuePath="Id" SelectedValue="{Binding CategoryId, Mode=TwoWay}"
                                                     VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{infra:Str ColPlace}" Width="1.3*" Binding="{Binding Place}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="8,0" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="{infra:Str ColNote}" Width="1.7*" Binding="{Binding Note}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="8,0" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="{infra:Str ColEvent}" Width="150" SortMemberPath="EventName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding EventName}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding EventChoices}" DisplayMemberPath="Name" SelectedValuePath="Key"
                                      SelectedValue="{Binding EventKey, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{infra:Str TransactionsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.6" IsHitTestVisible="False"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="True">
            <WrapPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Border CornerRadius="14" Padding="14,5" Margin="0,0,8,0" Background="{DynamicResource SystemControlBackgroundAccentBrush}">
                    <TextBlock Text="{Binding SelectionLabel}" FontWeight="SemiBold" Foreground="White" />
                </Border>
                <Border CornerRadius="14" Padding="14,5" Margin="0,0,8,0" Background="#33E53935">
                    <TextBlock Text="{Binding SelectionExpenseText}" FontWeight="SemiBold" Foreground="{StaticResource ExpenseBrush}" />
                </Border>
                <Border CornerRadius="14" Padding="14,5" Margin="0,0,8,0" Background="#3343A047">
                    <TextBlock Text="{Binding SelectionIncomeText}" FontWeight="SemiBold" Foreground="{StaticResource IncomeBrush}" />
                </Border>
                <Border CornerRadius="14" Padding="14,5" Background="#33F9A825">
                    <TextBlock Text="{Binding SelectionBalanceText}" FontWeight="Bold" />
                </Border>
            </WrapPanel>
            <WrapPanel>
                <Border CornerRadius="14" Padding="14,5" Margin="0,0,8,6" Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                    <TextBlock Text="{Binding AllLabel}" FontWeight="SemiBold" />
                </Border>
                <Border CornerRadius="14" Padding="14,5" Margin="0,0,8,6" Background="#33E53935">
                    <TextBlock Text="{Binding AllExpenseText}" FontWeight="SemiBold" Foreground="{StaticResource ExpenseBrush}" />
                </Border>
                <Border CornerRadius="14" Padding="14,5" Margin="0,0,8,6" Background="#3343A047">
                    <TextBlock Text="{Binding AllIncomeText}" FontWeight="SemiBold" Foreground="{StaticResource IncomeBrush}" />
                </Border>
                <Border CornerRadius="14" Padding="14,5" Margin="0,0,0,6" Background="#33F9A825">
                    <TextBlock Text="{Binding AllBalanceText}" FontWeight="Bold" />
                </Border>
            </WrapPanel>
        </DockPanel>
    </Grid>
</UserControl>
