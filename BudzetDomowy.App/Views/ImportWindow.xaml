<Window x:Class="BudzetDomowy.App.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        xmlns:controls="clr-namespace:BudzetDomowy.App.Controls"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/BudzetDomowy.App;component/Assets/BudzetDomowy.ico"
        Title="{infra:Str ImportTitle}" Width="1040" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{infra:Str ImportHeading}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{infra:Str ImportStep1}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStep2}" Value="True"><Setter Property="Text" Value="{infra:Str ImportStep2}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsStep3}" Value="True"><Setter Property="Text" Value="{infra:Str ImportStep3}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsStep4}" Value="True"><Setter Property="Text" Value="{infra:Str ImportStep4}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Text" Value="{infra:Str ImportStepDone}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Step 1: file and sheets -->
        <Grid Grid.Row="1" Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FileBox" Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" ui:ControlHelper.Header="{infra:Str ImportFile}" />
                <Button Grid.Column="1" Content="{infra:Str WizardBrowse}" Command="{Binding BrowseCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Sheets}" Margin="0,12,0,0" BorderThickness="1"
                     BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2" Opacity="{Binding CanImport, Converter={x:Static infra:DimConverter.Instance}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanImport}" MinWidth="0" Content="{Binding Name}" />
                            <TextBlock Grid.Column="2" Text="{Binding Info}" Opacity="0.7" VerticalAlignment="Center" Margin="12,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <CheckBox IsChecked="{Binding NegativeIsExpense}" Content="{infra:Str ImportSignOption}" ToolTip="{infra:Str ImportSignTip}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IncomeLabelFound, Converter={StaticResource BoolToVis}}">
                    <CheckBox IsChecked="{Binding UseIncomeLabel}" Content="{infra:Str ImportIncomeLabelOption}" />
                    <TextBox Text="{Binding IncomeLabel}" Width="160" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Step 2: columns -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Opacity="0.8" TextWrapping="Wrap">
                    <Run Text="{infra:Str ImportColumnsOf}" /> <Run Text="{Binding MappingSheetName, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <ComboBox ItemsSource="{Binding ColumnChoices}" SelectedItem="{Binding DateColumn}" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                          ui:ControlHelper.Header="{infra:Str ImportColDate}" />
                <ComboBox ItemsSource="{Binding ColumnChoices}" SelectedItem="{Binding AmountColumn}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                          ui:ControlHelper.Header="{infra:Str ImportColAmount}" />
                <ComboBox ItemsSource="{Binding ColumnChoices}" SelectedItem="{Binding CategoryColumn}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                          ui:ControlHelper.Header="{infra:Str ImportColCategory}" />
                <ComboBox ItemsSource="{Binding ColumnChoices}" SelectedItem="{Binding PlaceColumn}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                          ui:ControlHelper.Header="{infra:Str ImportColPlace}" />
                <ComboBox ItemsSource="{Binding ColumnChoices}" SelectedItem="{Binding NoteColumn}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                          ui:ControlHelper.Header="{infra:Str ImportColNote}" />
                <ComboBox ItemsSource="{Binding ColumnChoices}" SelectedItem="{Binding TypeColumn}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                          ui:ControlHelper.Header="{infra:Str ImportColType}" />
                <ui:NumberBox Value="{Binding HeaderRowNumber, Mode=TwoWay}" Minimum="1" Maximum="500" SpinButtonPlacementMode="Inline" Width="200" HorizontalAlignment="Left"
                              Margin="0,10,0,0" ui:ControlHelper.Header="{infra:Str ImportHeaderRow}" />
                <TextBlock Text="{infra:Str ImportColumnsHint}" Opacity="0.7" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Step 3: categories -->
        <Grid Grid.Row="1" Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{infra:Str ImportCategoriesHint}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CategoryRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" MaxWidth="460" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding CountText}" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Center" />
                                <controls:FilterComboBox Grid.Column="3" Choices="{Binding Targets}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                         HorizontalAlignment="Stretch" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Step 4: preview -->
        <Grid Grid.Row="1" Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}" Width="250" ui:ControlHelper.Header="{infra:Str ImportShow}" />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Bottom" Margin="16,0,0,6" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
            <DataGrid infra:GridBehaviors.ColumnChooserKey="import-preview" infra:GridBehaviors.AutoFit="{Binding AutoFitColumns, Source={x:Static infra:UiPreferences.Instance}}" Grid.Row="1" ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0"
                      HeadersVisibility="Column" GridLinesVisibility="All" CanUserAddRows="False" EnableRowVirtualization="True"
                      AlternationCount="2" AlternatingRowBackground="{DynamicResource SystemControlBackgroundListLowBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{infra:Str ImportColSheet}" Binding="{Binding Sheet}" Width="80" />
                    <DataGridTextColumn Header="{infra:Str ImportColRow}" Binding="{Binding ExcelRow}" Width="60" />
                    <DataGridTextColumn Header="{infra:Str ColDate}" Binding="{Binding Date}" Width="100" />
                    <DataGridTextColumn Header="{infra:Str ColAmount}" Binding="{Binding Amount}" Width="100" />
                    <DataGridTextColumn Header="{infra:Str ColCategory}" Binding="{Binding Category}" Width="*" />
                    <DataGridTextColumn Header="{infra:Str ColPlace}" Binding="{Binding Place}" Width="*" />
                    <DataGridTextColumn Header="{infra:Str ColNote}" Binding="{Binding Note}" Width="*" />
                    <DataGridTextColumn Header="{infra:Str ImportColStatus}" Binding="{Binding Status}" Width="220" />
                </DataGrid.Columns>
            </DataGrid>
            <ProgressBar Grid.Row="2" Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding Progress}" Height="8" Margin="0,10,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Done -->
        <StackPanel Grid.Row="1" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="✔" FontSize="56" Foreground="{StaticResource IncomeBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Result}" FontSize="18" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="640" Margin="0,12,0,0" />
        </StackPanel>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource ExpenseBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{infra:Str Cancel}" Command="{Binding CloseCommand}" MinWidth="90" Margin="0,0,8,0" x:Name="CancelButton" />
            <Button Content="{infra:Str WizardBack}" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" MinWidth="90" Margin="0,0,8,0" />
            <Button Content="{infra:Str WizardNext}" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" MinWidth="110"
                    Style="{StaticResource AccentButtonStyle}" x:Name="NextButton" />
            <Button Content="{infra:Str ImportDoImport}" Command="{Binding ImportCommand}" MinWidth="110"
                    Style="{StaticResource AccentButtonStyle}" x:Name="ImportButton" />
            <Button Content="{infra:Str Close}" Command="{Binding CloseCommand}" MinWidth="110" Style="{StaticResource AccentButtonStyle}" x:Name="DoneButton" />
        </StackPanel>
    </Grid>
</Window>
