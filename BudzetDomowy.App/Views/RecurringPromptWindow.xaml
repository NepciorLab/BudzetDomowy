<Window x:Class="BudzetDomowy.App.Views.RecurringPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/BudzetDomowy.App;component/Assets/BudzetDomowy.ico"
        Title="{infra:Str RecurPromptTitle}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="{infra:Str RecurPromptQuestion}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Date}" Opacity="0.75" Margin="0,8,0,0" />
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
        <TextBlock Text="{Binding Amount}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"
                   Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
        <TextBlock Text="{Binding Category}" Opacity="0.85" Margin="0,4,0,0" />
        <TextBlock Text="{Binding Schedule}" Opacity="0.6" Margin="0,2,0,0" />
        <TextBlock Text="{infra:Str RecurPromptHint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,16,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{infra:Str RecurPromptYes}" IsDefault="True" Click="Yes_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="{infra:Str RecurPromptNo}" Click="No_Click" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="{infra:Str RecurPromptLater}" IsCancel="True" Click="Later_Click" MinWidth="110" />
        </StackPanel>
    </StackPanel>
</Window>
