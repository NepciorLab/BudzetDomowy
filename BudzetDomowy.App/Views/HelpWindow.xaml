<Window x:Class="BudzetDomowy.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/BudzetDomowy.App;component/Assets/BudzetDomowy.ico"
        Title="{infra:Str HelpTitle}" Width="1180" Height="780" MinWidth="720" MinHeight="420"
        WindowStartupLocation="Manual" ShowInTaskbar="True" PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- the topics -->
        <Grid Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" Margin="10,10,10,6" TextChanged="SearchBox_TextChanged"
                     ui:ControlHelper.PlaceholderText="{infra:Str HelpSearchHint}" ToolTip="{infra:Str HelpSearchTip}" />
            <TreeView x:Name="Tree" Grid.Row="1" Margin="4,0,0,8" SelectedItemChanged="Tree_SelectedItemChanged"
                      BorderThickness="0" Background="Transparent" FontSize="14">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource DefaultTreeViewItemStyle}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Title}" Padding="0,3" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

        <!-- the page -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="10,8,10,0">
                <Button x:Name="BackButton" Content="◀" Width="40" Click="Back_Click" ToolTip="{infra:Str HelpBack}" />
                <Button x:Name="ForwardButton" Content="▶" Width="40" Margin="6,0,0,0" Click="Forward_Click" ToolTip="{infra:Str HelpForward}" />
                <TextBlock x:Name="Crumbs" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.7" />
            </StackPanel>
            <FlowDocumentScrollViewer x:Name="Viewer" Grid.Row="1" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="True" IsSelectionEnabled="True" />
        </Grid>
    </Grid>
</Window>
