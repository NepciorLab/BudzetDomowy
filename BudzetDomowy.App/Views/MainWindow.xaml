<Window infra:Help.Topic="main" x:Class="BudzetDomowy.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        xmlns:vm="clr-namespace:BudzetDomowy.App.ViewModels"
        xmlns:views="clr-namespace:BudzetDomowy.App.Views"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/BudzetDomowy.App;component/Assets/BudzetDomowy.ico"
        Title="{Binding WindowTitle}" Width="1280" Height="800" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate DataType="{x:Type vm:TransactionsViewModel}">
            <views:TransactionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BudgetsViewModel}">
            <views:BudgetsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecurringViewModel}">
            <Grid Margin="16,12,16,8">
                <views:RecurringView />
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PaymentsViewModel}">
            <views:PaymentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EventsViewModel}">
            <views:EventsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <StackPanel Margin="32" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.7" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>


    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Today's date, big -->
            <Border infra:Help.Topic="main.header" Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="20,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TodayText}" FontSize="30" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock x:Name="ClockLabel" Text="{Binding ClockText}" FontSize="30" FontWeight="Light" Foreground="#E6FFFFFF"
                                   VerticalAlignment="Center" Margin="24,0,0,0"
                                   Visibility="{Binding ShowClock, Source={x:Static infra:UiPreferences.Instance}, Converter={x:Static infra:BoolToVisibilityConverter.Visible}}" />
                    </StackPanel>
                    <TextBlock Text="{infra:Str AppTitleUpper}" FontSize="13" FontWeight="SemiBold" Foreground="#CCFFFFFF"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- instead of entry fields: what to press to enter something new -->
            <Border infra:Help.Topic="main.quick" Grid.Row="1" Padding="16,8" BorderThickness="0,0,0,1" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <StackPanel Orientation="Horizontal">
                    <Button infra:Help.Topic="entry.expense" x:Name="NewExpenseButton" Content="{Binding ExpenseHint}" Command="{Binding NewExpenseCommand}" Padding="16,6" Margin="0,0,10,0"
                            Foreground="{StaticResource ExpenseBrush}" FontWeight="SemiBold" />
                    <Button infra:Help.Topic="entry.income" x:Name="NewIncomeButton" Content="{Binding IncomeHint}" Command="{Binding NewIncomeCommand}" Padding="16,6"
                            Foreground="{StaticResource IncomeBrush}" FontWeight="SemiBold" Margin="0,0,10,0" />
                    <Button infra:Help.Topic="entry.calculator" x:Name="CalculatorButton" Command="{Binding OpenCalculatorCommand}" Padding="12,6" ToolTip="{infra:Str CalcTip}"
                            AutomationProperties.Name="{infra:Str CalcTitle}">
                        <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                    </Button>

                    <!-- what a long operation is doing (deleting thousands of entries...) -->
                    <StackPanel infra:Help.Topic="main.busy" x:Name="BusyBar" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"
                                Visibility="{Binding IsBusy, Source={x:Static infra:BusyStatus.Instance}, Converter={x:Static infra:BoolToVisibilityConverter.Visible}}">
                        <ui:ProgressRing IsActive="True" Width="20" Height="20" />
                        <TextBlock x:Name="BusyText" Text="{Binding Text, Source={x:Static infra:BusyStatus.Instance}}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="Nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                             BorderThickness="0" Padding="0,8,0,0" IsTabStop="False" infra:Help.Topic="main.nav">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,6" ToolTip="{Binding Shortcut}">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Width="28" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                                    <TextBlock Text="{Binding Title}" FontSize="15" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- the question mark: the next click on anything shows what it is -->
                    <ToggleButton x:Name="HelpButton" Grid.Row="1" Content="?" Width="36" Height="36" MinWidth="0" Padding="0" Margin="10,6,0,10"
                                  HorizontalAlignment="Left" FontSize="18" FontWeight="Bold" Click="HelpButton_Click"
                                  ToolTip="{infra:Str HelpButtonTip}" AutomationProperties.Name="{infra:Str HelpTitle}"
                                  infra:Help.Topic="help.button" />
                    <Border Grid.RowSpan="2" BorderThickness="0,0,1,0" IsHitTestVisible="False"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                </Grid>

                <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" IsTabStop="False" />
            </Grid>

            <Border Grid.Row="3" Padding="12,4" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                <Grid>
                    <Button infra:Help.Topic="main.sync" Command="{Binding ShowSyncDetailsCommand}" Padding="8,2" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Left" ToolTip="{infra:Str SyncClickForDetails}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SyncGlyph}" Foreground="{Binding SyncBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SyncText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel infra:Help.Topic="main.footer" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6">
                        <TextBlock Text="{Binding DeviceLabel}" />
                        <TextBlock Text="{Binding VersionLabel}" Margin="14,0,0,0" ToolTip="{infra:Str FooterVersionTip}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Discreet message with Undo -->
        <Border infra:Help.Topic="main.toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,92"
                CornerRadius="6" Padding="16,10" MaxWidth="640"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                Visibility="{Binding Toast.IsVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Toast.Message}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <Button Content="{infra:Str Undo}" Command="{Binding Toast.UndoCommand}" Margin="16,0,0,0"
                        Visibility="{Binding Toast.CanUndo, Converter={StaticResource BoolToVis}}" />
                <Button Content="✕" Command="{Binding Toast.HideCommand}" Margin="8,0,0,0" Background="Transparent" BorderThickness="0"
                        ToolTip="{infra:Str Close}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
