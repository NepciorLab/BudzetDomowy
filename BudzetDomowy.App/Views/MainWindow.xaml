<Window x:Class="BudzetDomowy.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
        xmlns:vm="clr-namespace:BudzetDomowy.App.ViewModels"
        xmlns:views="clr-namespace:BudzetDomowy.App.Views"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="pack://application:,,,/BudzetDomowy.App;component/Assets/BudzetDomowy.ico"
        Title="{Binding WindowTitle}" Width="1280" Height="800" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate DataType="{x:Type vm:TransactionsViewModel}">
            <views:TransactionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BudgetsViewModel}">
            <views:BudgetsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EventsViewModel}">
            <views:EventsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <StackPanel Margin="32" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.7" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding QuickAdd.ToggleTypeCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="F3" Command="{Binding FocusCurrencyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="F4" Command="{Binding FocusRateCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding FocusAmountCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding GoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="dashboard" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding GoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="transactions" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding GoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="budgets" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding GoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="events" />
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding GoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="reports" />
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding GoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="settings" />
    </Window.InputBindings>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Today's date, big -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="20,8">
                <Grid>
                    <TextBlock Text="{Binding TodayText}" FontSize="30" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{infra:Str AppTitleUpper}" FontSize="13" FontWeight="SemiBold" Foreground="#CCFFFFFF"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <views:QuickAddBar x:Name="QuickBar" Grid.Row="1" DataContext="{Binding QuickAdd}" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="Nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         BorderThickness="0,0,1,0" Padding="0,8,0,0" IsTabStop="False"
                         BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,6" ToolTip="{Binding Shortcut}">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Width="28" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                                <TextBlock Text="{Binding Title}" FontSize="15" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" IsTabStop="False" />
            </Grid>

            <Border Grid.Row="3" Padding="12,4" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                <Grid>
                    <Button Command="{Binding ShowSyncDetailsCommand}" Padding="8,2" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Left" ToolTip="{infra:Str SyncClickForDetails}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SyncGlyph}" Foreground="{Binding SyncBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SyncText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding DeviceLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6" />
                </Grid>
            </Border>
        </Grid>

        <!-- Discreet message with Undo -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,92"
                CornerRadius="6" Padding="16,10" MaxWidth="640"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                Visibility="{Binding Toast.IsVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Toast.Message}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <Button Content="{infra:Str Undo}" Command="{Binding Toast.UndoCommand}" Margin="16,0,0,0"
                        Visibility="{Binding Toast.CanUndo, Converter={StaticResource BoolToVis}}" />
                <Button Content="✕" Command="{Binding Toast.HideCommand}" Margin="8,0,0,0" Background="Transparent" BorderThickness="0"
                        ToolTip="{infra:Str Close}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
