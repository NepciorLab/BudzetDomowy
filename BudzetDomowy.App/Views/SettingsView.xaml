<UserControl x:Class="BudzetDomowy.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
             xmlns:vm="clr-namespace:BudzetDomowy.App.ViewModels"
             xmlns:controls="clr-namespace:BudzetDomowy.App.Controls"
             xmlns:local="clr-namespace:BudzetDomowy.App.Views">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>
    <TabControl Margin="16,8,16,8" Background="Transparent" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
        <!-- General -->
        <TabItem Header="{infra:Str SettingsGeneral}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0" MaxWidth="720" HorizontalAlignment="Left">
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Width="260"
                              ui:ControlHelper.Header="{infra:Str SettingsTheme}" />

                    <TextBlock Text="{infra:Str SettingsDataSection}" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,8" />
                    <TextBlock Text="{infra:Str SyncDetailsFolder}" Opacity="0.7" />
                    <TextBlock Text="{Binding DataFolder}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="{infra:Str SyncOpenFolder}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="{infra:Str FolderChange}" Command="{Binding ChangeDataFolderCommand}" />
                    </StackPanel>

                    <!-- a chosen new data folder: what we found there and what to do with the existing journals -->
                    <Border Visibility="{Binding HasPendingDataFolder, Converter={x:Static infra:BoolToVisibilityConverter.Visible}}"
                            CornerRadius="8" Padding="14,10" Margin="0,10,0,0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <StackPanel>
                            <TextBlock Text="{infra:Str FolderPendingTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PendingDataFolder}" TextWrapping="Wrap" Opacity="0.85" Margin="0,2,0,6" />
                            <ItemsControl ItemsSource="{Binding PendingChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox IsChecked="{Binding CopyJournals}" Content="{infra:Str FolderCopyJournals}" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{infra:Str FolderApply}" Command="{Binding ApplyDataFolderCommand}" IsEnabled="{Binding CanApplyDataFolder}"
                                        Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="{infra:Str Cancel}" Command="{Binding CancelDataFolderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{infra:Str SyncDetailsLocal}" Opacity="0.7" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding LocalFolder}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="{infra:Str SyncOpenFolder}" Command="{Binding OpenLocalFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="{infra:Str FolderChange}" Command="{Binding ChangeLocalFolderCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding FolderMessage}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding RestartNeeded, Converter={x:Static infra:BoolToVisibilityConverter.Visible}}">
                        <Button Content="{infra:Str FolderRestartNow}" Command="{Binding RestartNowCommand}" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>

                    <TextBlock Text="{infra:Str SyncDetailsThisDevice}" Opacity="0.7" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding DeviceName}" />
                    <TextBlock Text="{Binding DeviceId}" Opacity="0.6" />

                    <TextBlock Text="{infra:Str SettingsTablesHeading}" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,8" />
                    <CheckBox IsChecked="{Binding Preferences.AutoFitColumns, Mode=TwoWay}" Content="{infra:Str SettingsAutoFit}" />
                    <TextBlock Text="{infra:Str SettingsTablesHint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />

                    <TextBlock Text="{infra:Str SettingsBackgroundHeading}" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,8" />
                    <CheckBox IsChecked="{Binding BackgroundMode, Mode=TwoWay}" Content="{infra:Str SettingsBackgroundOption}" />
                    <TextBlock Text="{infra:Str SettingsBackgroundHint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding BackgroundMessage}" TextWrapping="Wrap" Foreground="{StaticResource ExpenseBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Categories -->
        <TabItem Header="{infra:Str SettingsCategories}" DataContext="{Binding Categories}">
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.2*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{infra:Str CategoryAdd}" Command="{Binding AddRootCommand}" Margin="0,0,8,0" />
                        <Button Content="{infra:Str CategoryAddChild}" Command="{Binding AddChildCommand}" Margin="0,0,8,0"
                                IsEnabled="{Binding HasSelection}" />
                        <Button Content="▲" Command="{Binding MoveUpCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,4,0"
                                ToolTip="{infra:Str CategoryMoveUp}" />
                        <Button Content="▼" Command="{Binding MoveDownCommand}" IsEnabled="{Binding HasSelection}"
                                ToolTip="{infra:Str CategoryMoveDown}" />
                    </StackPanel>
                    <TreeView x:Name="Tree" Grid.Row="1" ItemsSource="{Binding Roots}" SelectedItemChanged="Tree_SelectedItemChanged"
                              BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource DefaultTreeViewItemStyle}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:CategoryNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,3" Opacity="{Binding TitleOpacity}">
                                    <Ellipse Width="12" Height="12" Margin="0,0,8,0" Fill="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                    <TextBlock Text="{Binding Icon}" Width="22" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"
                                 ui:ControlHelper.Header="{infra:Str CategoryName}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding EditType, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                      ui:ControlHelper.Header="{infra:Str CategoryType}" />
                            <controls:FilterComboBox Grid.Column="2" Choices="{Binding ParentChoices}" DisplayMemberPath="Name"
                                                     SelectedValuePath="Key" SelectedValue="{Binding EditParentKey, Mode=TwoWay}"
                                                     HorizontalAlignment="Stretch"
                                                     ui:ControlHelper.Header="{infra:Str CategoryParent}" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding EditIcon, UpdateSourceTrigger=PropertyChanged}" MaxLength="8"
                                     ui:ControlHelper.Header="{infra:Str CategoryIcon}"
                                     ui:ControlHelper.PlaceholderText="{infra:Str CategoryIconHint}" />
                            <TextBox Grid.Column="2" Text="{Binding EditColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7"
                                     ui:ControlHelper.Header="{infra:Str CategoryColor}" ui:ControlHelper.PlaceholderText="#RRGGBB" />
                        </Grid>
                        <TextBlock Text="{infra:Str CategoryPickIcon}" Opacity="0.7" Margin="0,12,0,4" />
                        <ItemsControl ItemsSource="{Binding IconChoices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="34" Height="34" Margin="0,0,4,4" Padding="0" MinWidth="0" MinHeight="0" Content="{Binding}" FontSize="17"
                                            Command="{Binding DataContext.PickIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{infra:Str CategoryNoIcon}" Command="{Binding PickIconCommand}" CommandParameter="" Margin="0,2,0,0" />

                        <ItemsControl ItemsSource="{Binding Palette}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="26" Height="26" Margin="0,0,6,6" Padding="0" MinWidth="0" MinHeight="0"
                                            Background="{Binding Converter={StaticResource HexToBrush}}"
                                            Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" ToolTip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox IsChecked="{Binding EditArchived}" Content="{infra:Str CategoryArchived}" Margin="0,8,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="{infra:Str CategorySave}" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="{infra:Str CategoryRemove}" Command="{Binding RemoveCommand}" ToolTip="{infra:Str CategoryRemoveTip}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.85" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <!-- Import and export -->
        <TabItem Header="{infra:Str SettingsImportExport}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="{infra:Str ImportHeading}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{infra:Str SettingsImportText}" TextWrapping="Wrap" Margin="0,6,0,10" Opacity="0.85" />
                    <Button Content="{infra:Str SettingsImportButton}" Command="{Binding OpenImportCommand}" Style="{StaticResource AccentButtonStyle}" />

                    <TextBlock Text="{infra:Str SettingsExportHeading}" FontSize="18" FontWeight="SemiBold" Margin="0,30,0,0" />
                    <TextBlock Text="{infra:Str SettingsExportText}" TextWrapping="Wrap" Margin="0,6,0,10" Opacity="0.85" />
                    <WrapPanel>
                        <Button Content="{infra:Str ExportAllXlsx}" Command="{Binding ExportAllXlsxCommand}" Margin="0,0,8,8" />
                        <Button Content="{infra:Str ExportAllCsv}" Command="{Binding ExportAllCsvCommand}" Margin="0,0,8,8" />
                        <Button Content="{infra:Str ExportYearReport}" Command="{Binding ExportThisYearCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Diagnostics -->
        <TabItem Header="{infra:Str SettingsDiagnostics}">
            <local:DiagnosticsView DataContext="{Binding Diagnostics}" />
        </TabItem>

        <!-- Keyboard shortcuts -->
        <TabItem Header="{infra:Str SettingsShortcuts}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="{infra:Str ShortcutsIntro}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="5" Padding="10,3" HorizontalAlignment="Left"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                        <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
