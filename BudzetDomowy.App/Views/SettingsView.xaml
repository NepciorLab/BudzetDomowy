<UserControl infra:Help.Topic="settings" x:Class="BudzetDomowy.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:infra="clr-namespace:BudzetDomowy.App.Infrastructure"
             xmlns:vm="clr-namespace:BudzetDomowy.App.ViewModels"
             xmlns:controls="clr-namespace:BudzetDomowy.App.Controls"
             xmlns:local="clr-namespace:BudzetDomowy.App.Views">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:HexToBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>
    <TabControl Margin="16,8,16,8" Background="Transparent" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
        <!-- General -->
        <TabItem infra:Help.Topic="settings.general" Header="{infra:Str SettingsGeneral}">
            <ScrollViewer infra:Help.Topic="settings.general" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="{infra:Str SettingsDataSection}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{infra:Str SyncDetailsFolder}" Opacity="0.7" />
                    <TextBlock Text="{Binding DataFolder}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="{infra:Str SyncOpenFolder}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="{infra:Str FolderChange}" Command="{Binding ChangeDataFolderCommand}" />
                    </StackPanel>

                    <!-- a chosen new data folder: what we found there and what to do with the existing journals -->
                    <Border Visibility="{Binding HasPendingDataFolder, Converter={x:Static infra:BoolToVisibilityConverter.Visible}}"
                            CornerRadius="8" Padding="14,10" Margin="0,10,0,0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <StackPanel>
                            <TextBlock Text="{infra:Str FolderPendingTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PendingDataFolder}" TextWrapping="Wrap" Opacity="0.85" Margin="0,2,0,6" />
                            <ItemsControl ItemsSource="{Binding PendingChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox IsChecked="{Binding CopyJournals}" Content="{infra:Str FolderCopyJournals}" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{infra:Str FolderApply}" Command="{Binding ApplyDataFolderCommand}" IsEnabled="{Binding CanApplyDataFolder}"
                                        Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="{infra:Str Cancel}" Command="{Binding CancelDataFolderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{infra:Str SyncDetailsLocal}" Opacity="0.7" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding LocalFolder}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="{infra:Str SyncOpenFolder}" Command="{Binding OpenLocalFolderCommand}" Margin="0,0,8,0" />
                        <Button Content="{infra:Str FolderChange}" Command="{Binding ChangeLocalFolderCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding FolderMessage}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding RestartNeeded, Converter={x:Static infra:BoolToVisibilityConverter.Visible}}">
                        <Button Content="{infra:Str FolderRestartNow}" Command="{Binding RestartNowCommand}" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>

                    <TextBlock Text="{infra:Str SyncDetailsThisDevice}" Opacity="0.7" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding DeviceName}" />
                    <TextBlock Text="{Binding DeviceId}" Opacity="0.6" />

                    <TextBlock Text="{infra:Str SettingsTablesHeading}" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,8" />
                    <CheckBox IsChecked="{Binding Preferences.AutoFitColumns, Mode=TwoWay}" Content="{infra:Str SettingsAutoFit}" />
                    <TextBlock Text="{infra:Str SettingsTablesHint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />

                    <TextBlock Text="{infra:Str SettingsUpdatesHeading}" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,8" />
                    <CheckBox IsChecked="{Binding AutoUpdate, Mode=TwoWay}" Content="{infra:Str SettingsAutoUpdate}" />
                    <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap">
                        <Run Text="{infra:Str SettingsVersionIs}" /> <Run Text="{Binding CurrentVersionText, Mode=OneWay}" /> · <Run Text="{Binding UpdateRepository, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{infra:Str UpdateCheckNow}" Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding UpdateBusy, Converter={x:Static infra:BoolToVisibilityConverter.Not}}" Margin="0,0,8,0" />
                        <Button Content="{infra:Str UpdateInstallNow}" Command="{Binding InstallUpdateCommand}" Style="{StaticResource AccentButtonStyle}"
                                Visibility="{Binding UpdateAvailable, Converter={x:Static infra:BoolToVisibilityConverter.Visible}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateMessage}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Appearance -->
        <TabItem infra:Help.Topic="settings.appearance" Header="{infra:Str SettingsAppearance}">
            <ScrollViewer infra:Help.Topic="settings.appearance" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0" MaxWidth="720" HorizontalAlignment="Left">
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Width="260"
                              ui:ControlHelper.Header="{infra:Str SettingsTheme}" />

                    <ComboBox ItemsSource="{Binding StartPages}" SelectedItem="{Binding SelectedStartPage, Mode=TwoWay}" Width="260" Margin="0,16,0,0"
                              ui:ControlHelper.Header="{infra:Str SettingsStartPage}" />

                    <ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding SelectedScale, Mode=TwoWay}" Width="260" Margin="0,16,0,0"
                              ui:ControlHelper.Header="{infra:Str SettingsScale}" />
                    <TextBlock Text="{infra:Str SettingsScaleHint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />

                    <TextBlock Text="{infra:Str SettingsGraphics}" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,8" />
                    <ComboBox ItemsSource="{Binding Markers}" SelectedItem="{Binding SelectedMarker, Mode=TwoWay}" Width="260"
                              ui:ControlHelper.Header="{infra:Str SettingsMarker}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <controls:CategoryMarker Color="#1E88E5" Size="14" Margin="0,0,6,0" />
                        <controls:CategoryMarker Color="#43A047" Size="14" Margin="0,0,6,0" />
                        <controls:CategoryMarker Color="#FB8C00" Size="14" Margin="0,0,6,0" />
                        <controls:CategoryMarker Color="#8E24AA" Size="14" Margin="0,0,6,0" />
                        <controls:CategoryMarker Color="#E53935" Size="14" />
                    </StackPanel>

                    <CheckBox IsChecked="{Binding Preferences.ShowClock, Mode=TwoWay}" Content="{infra:Str SettingsShowClock}" Margin="0,16,0,0" />

                    <!-- the charts of the dashboard -->
                    <TextBlock Text="{infra:Str SettingsCharts}" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,8" />
                    <Grid Width="420" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Slider Value="{Binding Preferences.ChartBarWidth, Mode=TwoWay}" Minimum="8" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                                ui:ControlHelper.Header="{infra:Str SettingsChartBarWidth}" />
                        <TextBlock Grid.Column="1" Text="{Binding Preferences.ChartBarWidth, StringFormat='{}{0:0} px'}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        <Slider Grid.Row="1" Value="{Binding Preferences.ChartBarGap, Mode=TwoWay}" Minimum="0" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,10,0,0"
                                ui:ControlHelper.Header="{infra:Str SettingsChartBarGap}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Preferences.ChartBarGap, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        <Slider Grid.Row="2" Value="{Binding Preferences.ChartRingThickness, Mode=TwoWay}" Minimum="10" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,0"
                                ui:ControlHelper.Header="{infra:Str SettingsChartRing}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Preferences.ChartRingThickness, StringFormat='{}{0:0} px'}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        <Slider Grid.Row="3" Value="{Binding Preferences.ChartRows, Mode=TwoWay}" Minimum="5" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,0"
                                ui:ControlHelper.Header="{infra:Str SettingsChartRows}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Preferences.ChartRows, StringFormat='{}{0:0}'}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </Grid>
                    <TextBlock Text="{infra:Str SettingsChartRowsHint}" TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
                    <CheckBox IsChecked="{Binding Preferences.ChartBreakLargest, Mode=TwoWay}" Content="{infra:Str SettingsChartBreak}" ToolTip="{infra:Str SettingsChartBreakTip}" Margin="0,12,0,0" />

                    <TextBlock Text="{infra:Str SettingsAmounts}" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,8" />
                    <CheckBox IsChecked="{Binding Preferences.ShowMinus, Mode=TwoWay}" Content="{infra:Str SettingsShowMinus}" />
                    <CheckBox IsChecked="{Binding Preferences.ColorAmounts, Mode=TwoWay}" Content="{infra:Str SettingsColorAmounts}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{Binding SampleExpense}" FontWeight="SemiBold" Margin="0,0,24,0" Style="{StaticResource AmountExpenseSample}" />
                        <TextBlock Text="{Binding SampleIncome}" FontWeight="SemiBold" Style="{StaticResource AmountIncomeSample}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Categories -->
        <TabItem infra:Help.Topic="settings.categories" Header="{infra:Str SettingsCategories}" DataContext="{Binding Categories}">
            <Grid infra:Help.Topic="settings.categories" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.2*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{infra:Str CategoryAdd}" Command="{Binding AddRootCommand}" Margin="0,0,8,0" />
                        <Button Content="{infra:Str CategoryAddChild}" Command="{Binding AddChildCommand}" Margin="0,0,8,0"
                                IsEnabled="{Binding HasSelection}" />
                        <Button Content="▲" Command="{Binding MoveUpCommand}" IsEnabled="{Binding HasSelection}" Margin="0,0,4,0"
                                ToolTip="{infra:Str CategoryMoveUp}" />
                        <Button Content="▼" Command="{Binding MoveDownCommand}" IsEnabled="{Binding HasSelection}"
                                ToolTip="{infra:Str CategoryMoveDown}" />
                    </StackPanel>
                    <CheckBox Grid.Row="1" x:Name="InheritColorBox" Content="{infra:Str SettingsSubcategoryColor}" ToolTip="{infra:Str SettingsSubcategoryColorTip}"
                              IsChecked="{Binding SubcategoriesInheritColor, Source={x:Static infra:UiPreferences.Instance}, Mode=TwoWay}" Margin="0,0,0,8" />
                    <TreeView x:Name="Tree" Grid.Row="2" ItemsSource="{Binding Roots}" SelectedItemChanged="Tree_SelectedItemChanged"
                              BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource DefaultTreeViewItemStyle}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:CategoryNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,3" Opacity="{Binding TitleOpacity}">
                                    <controls:CategoryMarker Size="12" Color="{Binding Color}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Icon}" Width="22" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"
                                 ui:ControlHelper.Header="{infra:Str CategoryName}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding EditType, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                      ui:ControlHelper.Header="{infra:Str CategoryType}" />
                            <controls:FilterComboBox Grid.Column="2" Choices="{Binding ParentChoices}" DisplayMemberPath="Name"
                                                     SelectedValuePath="Key" SelectedValue="{Binding EditParentKey, Mode=TwoWay}"
                                                     HorizontalAlignment="Stretch"
                                                     ui:ControlHelper.Header="{infra:Str CategoryParent}" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding EditIcon, UpdateSourceTrigger=PropertyChanged}" MaxLength="8"
                                     ui:ControlHelper.Header="{infra:Str CategoryIcon}"
                                     ui:ControlHelper.PlaceholderText="{infra:Str CategoryIconHint}" />
                            <TextBox Grid.Column="2" Text="{Binding EditColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" IsEnabled="{Binding CanEditColor}"
                                     ui:ControlHelper.Header="{infra:Str CategoryColor}" ui:ControlHelper.PlaceholderText="#RRGGBB" />
                        </Grid>
                        <TextBlock Text="{infra:Str CategoryPickIcon}" Opacity="0.7" Margin="0,12,0,4" />
                        <ItemsControl ItemsSource="{Binding IconChoices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="34" Height="34" Margin="0,0,4,4" Padding="0" MinWidth="0" MinHeight="0" Content="{Binding}" FontSize="17"
                                            Command="{Binding DataContext.PickIconCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{infra:Str CategoryNoIcon}" Command="{Binding PickIconCommand}" CommandParameter="" Margin="0,2,0,0" />

                        <ItemsControl ItemsSource="{Binding Palette}" Margin="0,10,0,0" IsEnabled="{Binding CanEditColor}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="28" Height="28" Margin="0,0,6,6" Padding="0" MinWidth="0" MinHeight="0"
                                            Background="{Binding Hex, Converter={StaticResource HexToBrush}}"
                                            Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Hex}" ToolTip="{Binding Hex}">
                                        <Grid>
                                            <TextBlock Text="✔" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.9" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <Ellipse Width="6" Height="6" Fill="White" Stroke="#66000000" StrokeThickness="0.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     Margin="0,3,3,0" Visibility="{Binding IsUsed, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox IsChecked="{Binding EditArchived}" Content="{infra:Str CategoryArchived}" Margin="0,8,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="{infra:Str CategorySave}" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="{infra:Str CategoryRemove}" Command="{Binding RemoveCommand}" ToolTip="{infra:Str CategoryRemoveTip}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.85" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
        <!-- Import and export -->
        <TabItem infra:Help.Topic="settings.importexport" Header="{infra:Str SettingsImportExport}">
            <ScrollViewer infra:Help.Topic="settings.importexport" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="{infra:Str ImportHeading}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{infra:Str SettingsImportText}" TextWrapping="Wrap" Margin="0,6,0,10" Opacity="0.85" />
                    <Button infra:Help.Topic="import" Content="{infra:Str SettingsImportButton}" Command="{Binding OpenImportCommand}" Style="{StaticResource AccentButtonStyle}" />

                    <TextBlock Text="{infra:Str SettingsExportHeading}" FontSize="18" FontWeight="SemiBold" Margin="0,30,0,0" />
                    <TextBlock Text="{infra:Str SettingsExportText}" TextWrapping="Wrap" Margin="0,6,0,10" Opacity="0.85" />
                    <WrapPanel>
                        <Button Content="{infra:Str ExportAllXlsx}" Command="{Binding ExportAllXlsxCommand}" Margin="0,0,8,8" />
                        <Button Content="{infra:Str ExportAllCsv}" Command="{Binding ExportAllCsvCommand}" Margin="0,0,8,8" />
                        <Button Content="{infra:Str ExportYearReport}" Command="{Binding ExportThisYearCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Diagnostics -->
        <TabItem infra:Help.Topic="settings.diagnostics" Header="{infra:Str SettingsDiagnostics}">
            <local:DiagnosticsView infra:Help.Topic="settings.diagnostics" DataContext="{Binding Diagnostics}" />
        </TabItem>

        <!-- Backups -->
        <TabItem infra:Help.Topic="settings.backup" Header="{infra:Str SettingsBackup}">
            <Grid infra:Help.Topic="settings.backup" Margin="0,16,0,0" MaxWidth="900" HorizontalAlignment="Left" DataContext="{Binding Backup}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Opacity="0.85" />
                    <TextBlock Text="{infra:Str BackupFolderLabel}" Opacity="0.7" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding Folder}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                    <Button Content="{infra:Str BackupCreateNow}" Command="{Binding CreateNowCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"
                            IsEnabled="{Binding IsBusy, Converter={x:Static infra:BoolToVisibilityConverter.Not}}" />
                    <Button Content="{infra:Str BackupRestore}" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" Margin="0,0,8,0" />
                    <Button Content="{infra:Str SyncOpenFolder}" Command="{Binding OpenFolderCommand}" />
                </StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          GridLinesVisibility="All" AlternationCount="2" AlternatingRowBackground="{DynamicResource SystemControlBackgroundListLowBrush}"
                          infra:GridBehaviors.ColumnChooserKey="backups"
                          infra:GridBehaviors.AutoFit="{Binding AutoFitColumns, Source={x:Static infra:UiPreferences.Instance}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{infra:Str BackupColDate}" Binding="{Binding DateText}" Width="2*" />
                        <DataGridTextColumn Header="{infra:Str BackupColKind}" Binding="{Binding KindText}" Width="*" />
                        <DataGridTextColumn Header="{infra:Str BackupColSize}" Binding="{Binding SizeText}" Width="110" />
                        <DataGridTextColumn Header="{infra:Str BackupColFiles}" Binding="{Binding Files}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="3" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource SystemControlForegroundAccentBrush}" />
            </Grid>
        </TabItem>

        <!-- Keyboard shortcuts -->
        <TabItem infra:Help.Topic="settings.shortcuts" Header="{infra:Str SettingsShortcuts}">
            <ScrollViewer infra:Help.Topic="settings.shortcuts" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="{infra:Str ShortcutsIntro}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Shortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="5" Padding="10,3" HorizontalAlignment="Left"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                            Visibility="{Binding IsEditing, Converter={x:Static infra:BoolToVisibilityConverter.Hidden}}">
                                        <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontWeight="SemiBold" />
                                    </Border>
                                    <!-- waits for the next key press and takes it as the new shortcut (Esc cancels) -->
                                    <TextBox Grid.Column="0" IsReadOnly="True" Text="{infra:Str ShortcutPress}" BorderBrush="{DynamicResource SystemControlForegroundAccentBrush}"
                                             PreviewKeyDown="ShortcutBox_PreviewKeyDown" LostKeyboardFocus="ShortcutBox_LostFocus"
                                             IsVisibleChanged="ShortcutBox_VisibleChanged"
                                             Visibility="{Binding IsEditing, Converter={x:Static infra:BoolToVisibilityConverter.Visible}}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource ExpenseBrush}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0"
                                                Visibility="{Binding IsFixed, Converter={x:Static infra:BoolToVisibilityConverter.Hidden}}">
                                        <Button Content="{infra:Str ShortcutChange}" MinWidth="0" Padding="12,3"
                                                Command="{Binding DataContext.EditShortcutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{infra:Str ShortcutReset}" MinWidth="0" Padding="12,3" Margin="6,0,0,0"
                                                Visibility="{Binding CanReset, Converter={x:Static infra:BoolToVisibilityConverter.Visible}}"
                                                Command="{Binding DataContext.ResetShortcutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Suggestions of the "Place" box -->
        <TabItem infra:Help.Topic="settings.places" Header="{infra:Str SettingsPlaces}" DataContext="{Binding PlaceHints}">
            <Grid infra:Help.Topic="settings.places" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{infra:Str PlacesInfo}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12" />
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" ui:ControlHelper.Header="{infra:Str PlacesNewName}" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Text="{Binding NewWeight, UpdateSourceTrigger=PropertyChanged}" ui:ControlHelper.Header="{infra:Str PlacesColWeight}"
                             ui:ControlHelper.PlaceholderText="1" TextAlignment="Right" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="{infra:Str PlacesAdd}" Command="{Binding AddCommand}" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" />
                    <TextBox Grid.Column="4" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ui:ControlHelper.Header="{infra:Str PlacesSearch}" />
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Text="{Binding MinEntries, UpdateSourceTrigger=PropertyChanged}" Width="150" TextAlignment="Right" Margin="0,0,8,0"
                             ui:ControlHelper.Header="{infra:Str PlacesMinEntries}" ToolTip="{infra:Str PlacesMinEntriesTip}" />
                    <Button Content="{infra:Str PlacesImport}" Command="{Binding ImportCommand}" VerticalAlignment="Bottom" Margin="0,0,24,0" ToolTip="{infra:Str PlacesImportTip}" />
                    <Button Content="{infra:Str PlacesRemoveSelected}" Click="PlacesRemoveSelected_Click" VerticalAlignment="Bottom" ToolTip="{infra:Str PlacesRemoveSelectedTip}" />
                </StackPanel>
                <DataGrid x:Name="PlacesGrid" Grid.Row="3" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="All" SelectionMode="Extended" AlternationCount="2" PreviewKeyDown="PlacesGrid_PreviewKeyDown"
                          AlternatingRowBackground="{DynamicResource SystemControlBackgroundListLowBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{infra:Str PlacesColPlace}" Binding="{Binding Name, Mode=OneWay}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="{infra:Str PlacesColWeight}" Binding="{Binding Weight, UpdateSourceTrigger=LostFocus}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="TextAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{infra:Str PlacesColSource}" Binding="{Binding Source, Mode=OneWay}" IsReadOnly="True" Width="160" />
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="↺" Padding="8,2" MinWidth="0" Margin="0,0,4,0" ToolTip="{infra:Str PlacesResetTip}"
                                                Command="{Binding DataContext.ResetWeightCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanReset, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="✕" Padding="8,2" MinWidth="0" ToolTip="{infra:Str PlacesRemoveTip}"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Summary}" Opacity="0.85" />
                    <TextBlock Text="{Binding Message}" Margin="16,0,0,0" Opacity="0.85" />
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
