<Application x:Class="BudzetDomowy.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ExpenseBrush" Color="#E53935" />
            <SolidColorBrush x:Key="IncomeBrush" Color="#43A047" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F9A825" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
