<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BudzetDomowy.Core\BudzetDomowy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc5.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Icon of the .exe (Explorer, taskbar); regenerate with tools\MakeIcon.ps1 -->
    <!-- LiveCharts pulls in .NET Framework builds of OpenTK/SkiaSharp views; they work fine in WPF on .NET 8 -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <ApplicationIcon>Assets\BudzetDomowy.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The WPF SDK drops these two from the implicit usings -->
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same icon for the windows (title bar, Alt+Tab, taskbar button) -->
    <Resource Include="Assets\BudzetDomowy.ico" />
  </ItemGroup>

</Project>
