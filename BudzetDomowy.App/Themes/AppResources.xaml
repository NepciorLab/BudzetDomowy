<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.modernwpf.com/2019">
    <ResourceDictionary.MergedDictionaries>
        <ui:ThemeResources>
            <ui:ThemeResources.ThemeDictionaries>
                <!-- Warm orange accent (like the icon); dark theme is dark grey with a cool tint, never pure black -->
                <ResourceDictionary x:Key="Light">
                    <ResourceDictionary.MergedDictionaries>
                        <ui:ColorPaletteResources TargetTheme="Light" Accent="#E65100" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <ResourceDictionary.MergedDictionaries>
                        <ui:ColorPaletteResources TargetTheme="Dark" Accent="#FFA726" AltHigh="#262A33" AltLow="#262A33"
                                                  AltMediumHigh="#262A33" ChromeMedium="#2F343F" ChromeMediumLow="#2F343F"
                                                  ChromeLow="#363B47" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ui:ThemeResources.ThemeDictionaries>
        </ui:ThemeResources>
        <ui:XamlControlsResources />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="ExpenseBrush" Color="#E53935" />
    <SolidColorBrush x:Key="IncomeBrush" Color="#43A047" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F9A825" />
    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FB8C00" Offset="0" />
        <GradientStop Color="#F4511E" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
