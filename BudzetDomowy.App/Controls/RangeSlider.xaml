<UserControl x:Class="BudzetDomowy.App.Controls.RangeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="34" Focusable="False" IsTabStop="False">
    <UserControl.Resources>
        <!-- a round handle: the plain WPF thumb draws nothing -->
        <Style x:Key="HandleStyle" TargetType="Thumb">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Disc" Fill="{DynamicResource SystemControlBackgroundAltHighBrush}" Stroke="{DynamicResource SystemControlForegroundAccentBrush}" StrokeThickness="3" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Disc" Property="StrokeThickness" Value="5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="Transparent" SizeChanged="Root_SizeChanged" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border x:Name="Track" Height="4" CornerRadius="2" Margin="10,0" VerticalAlignment="Center" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Border x:Name="Selection" Height="4" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{DynamicResource SystemControlForegroundAccentBrush}" />
        <Canvas>
            <Thumb x:Name="LowerThumb" Style="{StaticResource HandleStyle}" Canvas.Top="7" DragStarted="Lower_DragStarted" DragDelta="Lower_DragDelta" PreviewKeyDown="Thumb_PreviewKeyDown" />
            <Thumb x:Name="UpperThumb" Style="{StaticResource HandleStyle}" Canvas.Top="7" DragStarted="Upper_DragStarted" DragDelta="Upper_DragDelta" PreviewKeyDown="Thumb_PreviewKeyDown" />
        </Canvas>
    </Grid>
</UserControl>
