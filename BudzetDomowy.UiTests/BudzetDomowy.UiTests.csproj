<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BudzetDomowy.App\BudzetDomowy.App.csproj" />
    <ProjectReference Include="..\BudzetDomowy.Core\BudzetDomowy.Core.csproj" />
    <ProjectReference Include="..\BudzetDomowy.Korekta\BudzetDomowy.Korekta.csproj" />
  </ItemGroup>

</Project>
